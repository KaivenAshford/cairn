# 复制成 .env 后填写。.env 已被 gitignore。

# 写入通道的令牌。用 `openssl rand -hex 32` 生成，少于 32 字符服务端会拒绝启动。
CAIRN_TOKEN=

# 服务端监听地址。默认只绑回环，由 Caddy 反代到公网。
# 注意：用 docker compose 时这一行会被 compose 的 environment 段覆盖成 0.0.0.0:8787。
# 容器里绑回环的话，经端口映射进来的连接会被全部拒绝，而症状极具迷惑性——
# 容器 running、healthcheck 还是绿的（探活也在容器内），只有外部访问失败。
CAIRN_ADDR=127.0.0.1:8787

# 条目落盘位置。这一行是**从仓库根目录跑服务**时的相对路径；
# 而 README 教的是 `cd server && go run .`，那种跑法用服务端内置的默认值即可
# （../web/content/entries），不要 source 这份 .env——否则条目会落进
# server/web/content/entries，一个 HTTP 201、磁盘上真有文件、站上永远不出现的地方。
# 用 docker compose 时这一行会被 compose 的 environment 段覆盖成容器内路径。
#
# 这个目录是单独的 private 仓库，四层可见度的条目都在里面。见 web/content/README.md。
CAIRN_CONTENT_DIR=./web/content/entries

# 容器以哪个 uid/gid 跑。必须是宿主机上那个内容目录的属主，否则写入一律 500。
# 取值：`id -u` 和 `id -g`。
CAIRN_UID=1000
CAIRN_GID=1000
TZ=Asia/Shanghai

# 供 scripts/n 使用。换域名时这一处最容易漏——另外两处是 deploy/Caddyfile
# 和 web/astro.config.mjs。
CAIRN_URL=https://example.com
