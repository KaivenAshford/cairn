# 复制成 .env 后填写。.env 已被 gitignore。

# 写入通道的令牌。用 `openssl rand -hex 32` 生成，少于 32 字符服务端会拒绝启动。
CAIRN_TOKEN=

# 服务端监听地址。默认只绑回环，由 Caddy 反代到公网。
# 注意：用 docker compose 时这一行会被 compose 的 environment 段覆盖成 0.0.0.0:8787。
# 容器里绑回环的话，经端口映射进来的连接会被全部拒绝，而症状极具迷惑性——
# 容器 running、healthcheck 还是绿的（探活也在容器内），只有外部访问失败。
CAIRN_ADDR=127.0.0.1:8787

# 条目落盘位置。这一行是**从仓库根目录跑服务**时的相对路径；
# 而 README 教的是 `cd server && go run .`，那种跑法用服务端内置的默认值即可
# （../web/content/entries），不要 source 这份 .env——否则条目会落进
# server/web/content/entries，一个 HTTP 201、磁盘上真有文件、站上永远不出现的地方。
# 用 docker compose 时这一行会被 compose 的 environment 段覆盖成容器内路径。
#
# 这个目录是单独的 private 仓库，四层可见度的条目都在里面。见 web/content/README.md。
CAIRN_CONTENT_DIR=./web/content/entries

# 容器以哪个 uid/gid 跑。必须是宿主机上那个内容目录的属主，否则写入一律 500。
# 取值：`id -u` 和 `id -g`。
CAIRN_UID=1000
CAIRN_GID=1000
TZ=Asia/Shanghai

# 供 scripts/n 使用，服务端也会读它——Telegram 那句确认里的链接就是拿它拼的
# （没配就只回路径，不猜域名）。换域名时这一处最容易漏——另外两处是 deploy/Caddyfile
# 和 web/astro.config.mjs。
CAIRN_URL=https://example.com

# ── Telegram 写入通道（可选）─────────────────────────────────────────────────
# 手机上发一条消息 → 站上一条记录。两个都留空 = 不开这条通道，路由根本不注册；
# 只填一个 = **拒绝启动**。半配才是唯一危险的状态：填了名单忘了 secret，
# 等于把一个能往磁盘写文件的端点挂在公网上，靠「没人知道这个路径」活着。
# 开通步骤见 deploy/README.md 的「Telegram 写入通道」。

# setWebhook 时登记的 secret_token，之后 Telegram 每次推送都会带在
# X-Telegram-Bot-Api-Secret-Token 头里。它证明「这个请求来自 Telegram」。
# 用 `openssl rand -hex 32` 生成；少于 32 字符、或含 A-Z a-z 0-9 _ - 之外的字符，
# 服务端会拒绝启动（后者是因为 Telegram 那边也不收，不然要到调 setWebhook 才发现）。
CAIRN_TELEGRAM_SECRET=

# 允许写入的 Telegram 数字用户 id，逗号或空格分隔。它证明「这条消息来自我」。
# 只认数字，不认 @用户名：用户名能被改掉、放弃后还能被别人注册走。
# 怎么知道自己的 id：先把这两行配上（名单里随便填一个数），起服务，
# 给 bot 发一条消息——服务端日志里会有「拒绝来自 <id> 的消息」，那个就是。
CAIRN_TELEGRAM_ALLOW=
