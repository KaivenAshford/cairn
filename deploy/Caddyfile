# 换成你的域名。Caddy 会自动签发并续期证书。
example.com {
	encode zstd gzip

	# 静态产物：public + unlisted。这条是默认路径，绝大多数请求走这里。
	root * /srv/cairn/web/dist
	file_server

	# 只有静态壳做不到的事才转给 Go 服务。见 ARCHITECTURE.md 第 1 节。
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle /circle/* {
		reverse_proxy 127.0.0.1:8787
	}

	# unlisted 靠「搜不到」，兜底再挡一层爬虫。
	@unlisted path /u/*
	header @unlisted X-Robots-Tag "noindex, nofollow"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
