FROM golang:1.26-alpine AS build
WORKDIR /src
COPY server/go.mod ./
COPY server/*.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /cairn-server .

FROM gcr.io/distroless/static-debian12
COPY --from=build /cairn-server /cairn-server
USER nonroot:nonroot
EXPOSE 8787
ENTRYPOINT ["/cairn-server"]
