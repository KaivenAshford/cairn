#!/usr/bin/env bash
# 可见度的安全性质测试。
#
# 这些不是功能性质，是安全性质：「标了 private 却被构建进公开产物」不会有人报 bug，
# 它安静地发生，然后一直公开着。所以每一条都要有一个跑得起来的断言，而不是靠记得。
#
#   scripts/test-visibility
#
# 做法是往内容目录里放临时 markdown、跑真正的 astro build、断言构建的成败与产物，
# 结束时无论成败都清掉临时文件并重建一次干净产物。
#
# 内容目录是一个 private 仓库（见 web/content/README.md），四层可见度的条目混在一起，
# 由 frontmatter 决定谁进 dist。这条防线是软的（字段过滤），所以下面第 1、2 组
# 是这个文件里最要紧的断言：private / circle 的**任何**痕迹都不能出现在 dist 里。
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1
ENTRIES=web/content/entries
AI_JSON=web/src/data/ai.json
AI_BACKUP=""
PF_TMP=""
declare -a MADE=()
fails=0

# shellcheck disable=SC2317  # 由下面的 trap 调用，shellcheck 追不到这条路径
cleanup() {
  for f in "${MADE[@]:-}"; do rm -f "$f"; done
  # 第 21 组会把 web/src/data/ai.json 换成一份空快照再换回来。中途失败（或被 Ctrl-C）
  # 的话，工作树里就留着一份假数据，而它是**要进 git 的文件**——下次提交就把
  # 「一天记录都没有」提上去了。所以还原写在 cleanup 里，不写在那一组的末尾。
  # 用 cp 再删而不是 mv：目标已存在时 cp 保留**目标**的权限位，
  # 而 mv 会把 mktemp 那份 0600 一起搬过去——一个要进 git 的文件就此变成 0600，
  # 而这件事在 diff 里看不出来，只在 `git status` 的 mode 变更里闪一下。
  [ -n "${AI_BACKUP:-}" ] && [ -f "$AI_BACKUP" ] && cp "$AI_BACKUP" "$AI_JSON" && rm -f "$AI_BACKUP"
  rm -rf "$ENTRIES/2026"
  # 第 22 组会在 /tmp 下造几份最小仓库给 scripts/preflight 检查。中途失败或被 Ctrl-C
  # 的话，那几份里带着 .env（内容是假的，但形状是真的）——不清掉就是在 /tmp 里
  # 留一堆看起来像凭证的文件。
  [ -n "${PF_TMP:-}" ] && rm -rf "$PF_TMP"
  # 测试里那些**故意失败**的构建已经清空过 docroot，并留下一批含条目正文的中间 chunk。
  # 先整个删掉再走安全发布路径：宁可 dist 是空的，也不能是「空的 + 泄露的 .mjs」。
  # 失败要喊出来，不能用 `|| true` 咽掉——那正是这个脚本在防的事。
  rm -rf web/dist
  if ! scripts/publish >/dev/null; then
    echo >&2
    echo >&2 "⚠ 收尾构建失败：工作树本身就构建不过，web/dist 已清空且没有恢复。"
    echo >&2 "  先修好工作树，再跑一次 scripts/publish。"
  fi
}
trap cleanup EXIT

# 每次运行的 fixture 前缀带随机后缀，从根上消掉和真实条目撞名的可能。
T="zz-$(openssl rand -hex 4)"

entry() { # entry <文件名> <内容>
  local path="$ENTRIES/$1.md"
  # 内容目录是一个单独的 private 仓库，里面是真实内容，不是测试的暂存区。
  # 撞名就停下：它不进代码仓的 git，被覆盖或删掉就真的没了。
  if [ -e "$path" ]; then
    echo >&2 "拒绝覆盖已存在的 $path"
    echo >&2 "  内容目录是你的真实内容。请把那条条目挪开，或改这个测试的 fixture 名。"
    exit 1
  fi
  MADE+=("$path")
  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$2" > "$path"
}

build() { (cd web && npm run build 2>&1); }

ok()  { printf '  \033[32m✓\033[0m %s\n' "$1"; }
bad() { printf '  \033[31m✗\033[0m %s\n' "$1"; fails=$((fails + 1)); }

# leaks <标记> —— dist 里有没有这个标记
leaks() { grep -rqF "$1" web/dist 2>/dev/null; }

echo "可见度安全性质："

# ── 1. private / circle 条目不进产物，一个字都不能漏 ─────────────────────────
entry "$T-private" '---
title: ZZ_PRIVATE_TITLE 不该出现在产物里
type: post
visibility: private
created: 2026-01-01
tags: [ZZ_PRIVATE_TAG]
---

ZZ_PRIVATE_BODY'
entry "$T-circle" '---
title: ZZ_CIRCLE_TITLE
type: note
visibility: circle
created: 2026-01-01
---

ZZ_CIRCLE_BODY'
if build >/dev/null; then
  hit=0
  for marker in ZZ_PRIVATE_TITLE ZZ_PRIVATE_BODY ZZ_PRIVATE_TAG ZZ_CIRCLE_TITLE ZZ_CIRCLE_BODY zz-private zz-circle; do
    if leaks "$marker"; then bad "private/circle 的 '$marker' 出现在了 dist 里"; hit=1; fi
  done
  [ "$hit" -eq 0 ] && ok "private 与 circle 的标题、正文、标签、id 都不进 dist"
  if [ -e "web/dist/e/$T-private" ] || [ -e "web/dist/e/$T-circle" ]; then
    bad "private/circle 条目生成了页面"
  else
    ok "private 与 circle 条目不生成页面"
  fi
else
  bad "混入 private/circle 条目让构建失败了——它们应当被过滤掉，不是让构建挂掉"
fi
rm -f "$ENTRIES/$T-private.md" "$ENTRIES/$T-circle.md"

# ── 2. 忘写 visibility → 默认 private → 同样不进产物 ─────────────────────────
entry "$T-novis" '---
title: ZZ_NOVIS_TITLE
type: log
created: 2026-01-01
---

ZZ_NOVIS_BODY'
if build >/dev/null; then
  if leaks ZZ_NOVIS_BODY || leaks ZZ_NOVIS_TITLE; then
    bad "忘写 visibility 的条目被公开了——默认值应当是 private"
  else
    ok "忘写 visibility 时默认 private，不进 dist"
  fi
else
  bad "忘写 visibility 让构建失败了"
fi
rm -f "$ENTRIES/$T-novis.md"

# ── 3. unlisted 用了猜得到的文件名 → 大声失败 ────────────────────────────────
# 这是唯一一层强度取决于文件名的可见度，所以它必须失败，而不是被悄悄过滤掉。
entry "$T-guessable" '---
title: 猜得到的文件名
type: log
visibility: unlisted
created: 2026-01-01
---

ZZ_GUESSABLE_BODY'
if out=$(build); then
  bad "unlisted 用可猜的文件名，构建居然通过了"
elif ! grep -qF "$T-guessable" <<<"$out"; then
  bad "unlisted 文件名检查失败了，但没说清是哪一条"
else
  ok "unlisted 用可猜的文件名会让构建失败"
fi
rm -f "$ENTRIES/$T-guessable.md"

# ── 4. 非法 type / 拼错的 visibility → schema 拒绝（fail-closed） ────────────
entry "$T-badtype" '---
type: video
visibility: public
created: 2026-01-01
---

ZZ_BADTYPE_BODY'
if build >/dev/null; then bad "非法 type 居然通过了"; else ok "非法 type 被 schema 拒绝"; fi
rm -f "$ENTRIES/$T-badtype.md"

entry "$T-typo" '---
type: log
visibility: pubic
created: 2026-01-01
---

ZZ_TYPO_BODY'
if build >/dev/null; then bad "visibility 拼错居然通过了"; else ok "visibility 拼错时 fail-closed"; fi
rm -f "$ENTRIES/$T-typo.md"

# ── 5. 合法的 unlisted：随机路径、noindex、不上首页、不漏进别的产物 ──────────
RAND=$(openssl rand -hex 16)
entry "$RAND" '---
title: 未列出的条目
type: log
visibility: unlisted
created: 2026-01-01
---

ZZ_UNLISTED_SECRET_BODY'
if build >/dev/null; then
  page="web/dist/u/$RAND/index.html"
  if [ -f "$page" ]; then ok "unlisted 生成在 /u/<随机名>/"; else bad "unlisted 没有生成在 /u/$RAND/"; fi

  if grep -q 'name="robots" content="noindex, nofollow"' "$page" 2>/dev/null; then
    ok "unlisted 页面带 noindex, nofollow"
  else
    bad "unlisted 页面缺 noindex"
  fi

  if grep -q "$RAND" web/dist/index.html; then bad "unlisted 出现在首页"; else ok "unlisted 不出现在首页"; fi

  hits=$(grep -rl ZZ_UNLISTED_SECRET_BODY web/dist 2>/dev/null | wc -l)
  if [ "$hits" -eq 1 ]; then
    ok "unlisted 正文只出现在它自己那一页"
  else
    bad "unlisted 正文出现在 $hits 个产物里，应当只有 1 个"
  fi
else
  bad "合法的 unlisted 条目让构建失败了"
fi
rm -f "$ENTRIES/$RAND.md"

# ── 6. 按目录归档的 unlisted：随机段在目录名上，URL 同样猜不到 ───────────────
RAND2=$(openssl rand -hex 16)
entry "2026/$RAND2" '---
title: 归档在子目录里的未列出条目
type: log
visibility: unlisted
created: 2026-01-01
---

ZZ_SUBDIR_BODY'
if build >/dev/null; then
  ok "子目录里的 unlisted（随机段在路径中）能正常构建"
else
  bad "子目录里的 unlisted 让构建失败了——守卫应当看路径段，不是整个 id"
fi
rm -rf "$ENTRIES/2026"

# ── 7. 摘要与标题：代码里的标识符不能被当成 markdown 标记吃掉 ───────────────
# 这不是安全性质，但它出现在首页标题和 <meta name="description"> 里，
# 而这个站会大量写到环境变量名和路径。
#
# 注意下面那个标记不带下划线：带的话，「下划线被当斜体吃掉」这条缺陷会连标记一起改写，
# grep 于是永远匹配不到，测试看起来通过了——一个测自己测不出来的测试。
# shellcheck disable=SC2016  # 这是条目正文，里面的 ` 和 $ 都要原样落盘
entry "$T-excerpt" '---
type: log
visibility: public
created: 2026-01-01
---

环境变量是 `CAIRN_CONTENT_DIR`，模式是 `**/*.md`。

```js
const zzCodeMustNotLeak = 1;'
if build >/dev/null; then
  home=web/dist/index.html
  if grep -q "CAIRN_CONTENT_DIR" "$home"; then
    ok "反引号里的标识符原样保留（下划线不是斜体标记）"
  else
    bad "CAIRN_CONTENT_DIR 被当成 markdown 标记改写了（应当原样出现在摘要里）"
  fi
  if grep -q "zzCodeMustNotLeak" "$home"; then
    bad "未闭合代码块的内容漏进了摘要"
  else
    ok "未闭合的代码块不进摘要"
  fi
else
  bad "含代码的条目让构建失败了"
fi
rm -f "$ENTRIES/$T-excerpt.md"

# ── 8. 卡片版式：六色 chip、清单铺项、外链域名、筛选不连坐 ─────────────────
# 这些不是安全性质，但它们是「卡片按 type 长得不一样」这版设计的**前提**：
# 少了 data-type，六种颜色全部退回默认色，整版设计就只剩白卡。
entry "$T-list" '---
title: 在读
type: list
visibility: public
created: 2026-01-02
---

- 《档案：一部社会史》
- 《中文排版需求》
- 《The Design of Everyday Things》'
entry "$T-link" '---
type: link
visibility: public
created: 2026-01-01
---

[TypeScript 的 Go 移植版](https://github.com/microsoft/typescript-go) —— 编译器换宿主语言。'
if build >/dev/null; then
  home=web/dist/index.html
  n=$(grep -o 'class="chip" data-type="[a-z]*"' "$home" | sort -u | wc -l)
  if [ "$n" -ge 3 ]; then ok "chip 带 data-type（$n 种），六色配色才成立"
  else bad "chip 缺 data-type，六种 type 会全部退回默认色"; fi

  if grep -q '<ul class="preview">' "$home"; then ok "清单卡把列表项铺了出来"
  else bad "清单卡没有铺出列表项——只给标题的话，一张清单和一条短记在屏幕上一样重"; fi

  if grep -q '<span class="host">github.com</span>' "$home"; then ok "外链卡显示目标域名"
  else bad "外链卡没显示域名——「这条链接通向哪」是外链最重要的一条信息"; fi

  # 时间流里的顶层 <li> 有两种（卡片、年份标记），卡片里还嵌着第三种（清单卡的预览项）。
  # 筛选必须同时限定「只看直接子元素」和「只动 .card」：
  # 抓所有 li → 一按「清单」，清单卡自己的预览项会因为「type 不匹配」被整排隐藏；
  # 抓所有顶层 li → 年份标记会被当成一张类型不匹配的卡，一按任何类型全部消失。
  if grep -q '\[\.\.\.stream\.children\]' web/src/pages/index.astro &&
     grep -q "classList\.contains('card')" web/src/pages/index.astro; then
    ok "筛选只作用于顶层的 .card（预览项和年份标记都不会被连坐）"
  else
    bad "筛选没有限定在顶层 .card —— 预览项会被连坐隐藏，年份标记会被当成卡片筛掉"
  fi
else
  bad "清单/外链条目让构建失败了"
fi
rm -f "$ENTRIES/$T-list.md" "$ENTRIES/$T-link.md"

# ── 9. 卡片渲染的边界：不能产出没有任何文字、却整片可点的卡 ────────────────
# excerpt 会剥掉代码块和表格。正文「全是被剥掉的东西」时它返回空串，
# 碎片卡的标题就整个是空的——屏幕阅读器读到一个没有名字的链接。
entry "$T-tableonly" '---
type: log
visibility: public
created: 2026-01-03
---

| 页面 | 对每个访客一样吗 |
|---|---|
| 首页 | 是 |'
entry "$T-tablefirst" '---
type: note
visibility: public
created: 2026-01-04
---

| 层 | 走哪条 |
|---|---|
| public | 静态 |

TABLEFIRST_BODY 表格后面这段才是正文。'
if build >/dev/null; then
  if grep -qE "<a class=\"t\" href=\"/e/$T-tableonly/\">\s*</a>" web/dist/index.html; then
    bad "纯表格条目渲染出了空标题的可点卡片"
  else
    ok "纯表格条目仍有标题（不会出现无名可点卡）"
  fi
  h1=$(grep -o "<h1>[^<]*</h1>" "web/dist/e/$T-tablefirst/index.html" 2>/dev/null | head -1)
  if [ "$h1" = "<h1>（无题）</h1>" ]; then
    bad "正文以表格开头 → 标题退回「（无题）」，而下一段明明有正文"
  else
    ok "正文以表格开头时，标题取的是后面那段真正文"
  fi
else
  bad "含表格的条目让构建失败了"
fi
rm -f "$ENTRIES/$T-tableonly.md" "$ENTRIES/$T-tablefirst.md"

# ── 10. 清单卡只铺顶层项、外链卡指向真正的目标 ──────────────────────────────
entry "$T-nested" '---
title: 有子项的清单
type: list
visibility: public
created: 2026-01-05
---

- 顶层甲
  - NESTED_CHILD 子项不该被铺出来
- 顶层乙'
entry "$T-imglink" '---
type: link
visibility: public
created: 2026-01-06
---

![截图](https://cdn.example-shot.test/s.png)

[真正的目标](https://real-target.test/a)'
if build >/dev/null; then
  if grep -q "NESTED_CHILD" web/dist/index.html; then
    bad "清单卡把缩进的子项当顶层项铺了出来（还会挤占名额、让「还有 N 条」算错）"
  else
    ok "清单卡只铺顶层项，子项不平铺"
  fi
  if grep -q '"host">cdn.example-shot.test<' web/dist/index.html; then
    bad "外链卡显示的是配图的图床域名，不是这条链接真正指向的地方"
  elif grep -q '"host">real-target.test<' web/dist/index.html; then
    ok "外链卡指向真正的目标，不被正文配图带偏"
  else
    bad "外链卡没显示域名"
  fi
else
  bad "清单/外链边界条目让构建失败了"
fi
rm -f "$ENTRIES/$T-nested.md" "$ENTRIES/$T-imglink.md"

# ── 11. 版式的两条结构性约束（源码断言，产物里看不出来） ───────────────────
# grid 轨道的 base size 是 item 的 min-content，而 body 的 overflow-wrap 只管换行、
# 不改 min-content。少了这条下限，正文里一条长 URL 就能把整条轨道撑破视口——
# 实测 200% 字号下 375px 视口横向滚动，违反 WCAG 1.4.4 / 1.4.10。
if grep -q "grid-template-columns: minmax(0, 1fr)" web/src/styles/global.css; then
  ok "时间流的 grid 轨道有 0 下限（长 URL 不会撑破视口）"
else
  bad "grid 轨道缺 minmax(0,1fr)，长 URL 会在放大字号时撑出横向滚动"
fi
# UA 的 [hidden]{display:none} 属于 user-agent origin，作者样式里的 display:flex 会赢它。
if grep -q "\.filters\[hidden\] { display: none; }" web/src/styles/global.css; then
  ok "筛选条的 hidden 真的生效（JS 失效时不显示死按钮）"
else
  bad "\.filters 的 display:flex 盖掉了 hidden，无 JS 时按钮显示但点不动"
fi
# 播报的数字是屏幕阅读器用户按下筛选钮后唯一的反馈，肉眼验收发现不了它错。
if grep -q "querySelectorAll(':scope > li\.card:not(\[hidden\])')" web/src/pages/index.astro; then
  ok "筛选播报只数顶层的 .card（预览项、年份标记都不算）"
else
  bad "筛选播报数错了对象（清单卡的预览项或年份标记被算进去），读屏器听到的条数是错的"
fi

# ── 12. 出口三件套：feed / sitemap / robots ─────────────────────────────────
# feed 和 sitemap 是这个站主动**把 URL 递出去**的两个产物：一个群发给订阅者，
# 一个直接交给搜索引擎。unlisted 的全部防护是「猜不到」，混进这两个文件里的话，
# 页面上的 noindex 一点用都没有——路径已经在别人的库里了。
# 所以这一组既断言「不该有的没有」，也断言「该有的有」：一个空文件同样能让前者通过。
RAND3=$(openssl rand -hex 16)
entry "$RAND3" '---
title: ZZ_FEED_UNLISTED_TITLE
type: note
visibility: unlisted
created: 2026-01-07
---

ZZ_FEED_UNLISTED_BODY'
entry "$T-out" '---
title: ZZ_OUT_TITLE 公开条目
type: post
visibility: public
created: 2026-01-08
---

ZZ_OUT_BODY 这条应当出现在 feed 和 sitemap 里。'
if build >/dev/null; then
  feed=web/dist/feed.xml
  smap=web/dist/sitemap.xml
  robots=web/dist/robots.txt

  if [ -f "$feed" ] && [ -f "$smap" ] && [ -f "$robots" ]; then
    ok "feed.xml / sitemap.xml / robots.txt 都生成了"
  else
    bad "出口三件套缺文件（feed=$([ -f "$feed" ] && echo 有 || echo 无) sitemap=$([ -f "$smap" ] && echo 有 || echo 无) robots=$([ -f "$robots" ] && echo 有 || echo 无)）"
  fi

  # 合法 XML。手写 XML 的失败方式是「转义漏了一个字符 → 整份文档解析失败」，
  # 而阅读器那边的表现是「这个源坏了」，肉眼看产物是看不出来的。
  if python3 -c 'import sys,xml.etree.ElementTree as ET;[ET.parse(f) for f in sys.argv[1:]]' "$feed" "$smap" 2>/dev/null; then
    ok "feed 与 sitemap 是合法 XML"
  else
    bad "feed 或 sitemap 解析失败（转义漏了字符的话，整份文档都用不了）"
  fi

  # 正例先立住：不然下面几条「不含 unlisted」的断言对一个空文件也成立。
  if grep -qF "$T-out" "$feed" && grep -qF "$T-out" "$smap"; then
    ok "public 条目进了 feed 与 sitemap"
  else
    bad "public 条目没进 feed/sitemap——下面几条「不含 unlisted」的断言因此不算数"
  fi

  if [ -f "web/dist/u/$RAND3/index.html" ]; then
    for f in "$feed" "$smap"; do
      for marker in "$RAND3" ZZ_FEED_UNLISTED_TITLE ZZ_FEED_UNLISTED_BODY; do
        if grep -qF "$marker" "$f"; then bad "unlisted 的 '$marker' 出现在了 $(basename "$f") 里"; fi
      done
    done
    ok "unlisted 的 id、标题、正文都不进 feed 与 sitemap（数据源是 publicEntries）"
  else
    bad "unlisted fixture 没构建出来，这一组的断言不算数"
  fi

  if grep -qF '/u/' "$smap"; then
    bad "sitemap 里出现了 /u/——那是把猜不到的路径主动递给搜索引擎"
  else
    ok "sitemap 里没有任何 /u/ 路径"
  fi

  # feed 的条目数 == public 条目数。/e/ 下的目录是另一条独立算出来的答案
  # （getStaticPaths 用的同样是 publicEntries），两边对不上就是漏了或多了谁。
  n_feed=$(grep -c '<entry>' "$feed")
  n_pub=$(find web/dist/e -mindepth 1 -maxdepth 1 -type d | wc -l)
  if [ "$n_feed" -eq "$n_pub" ]; then
    ok "feed 里 $n_feed 条 == public 条目数 $n_pub"
  else
    bad "feed 里 $n_feed 条，public 条目有 $n_pub 条"
  fi

  # robots.txt 的 Sitemap 行是搜索引擎找到 sitemap 的唯一入口。
  if grep -q "^Sitemap: https\?://.*/sitemap\.xml$" "$robots"; then
    ok "robots.txt 里有绝对 URL 的 Sitemap 行"
  else
    bad "robots.txt 缺 Sitemap 行（或不是绝对 URL）"
  fi
  # 这条反直觉，所以要有断言钉住，防止下一个人「顺手补上」：
  # 禁止抓取 /u/ 会让爬虫取不到那一页，于是看不到页面上的 noindex，
  # 而从别处（聊天预览、referrer）发现的链接反而可能被仅凭 URL 收录。
  # noindex 要生效，前提是允许抓取。robots.txt 本身还是公开的——写上等于宣布秘密在哪。
  if grep -qi 'Disallow: */u/' "$robots"; then
    bad "robots.txt 里有 Disallow: /u/——爬虫取不到那页就看不到 noindex，反而更容易被仅凭 URL 收录"
  else
    ok "robots.txt 不禁止抓取 /u/（noindex 要生效，前提是允许抓取）"
  fi

  # /now/ 与 /e/now/ 是同一份内容的两个 URL。sitemap 是「我主动推荐哪一个」，
  # 两个都推等于让搜索引擎自己挑，搜出来的很可能是那个没人认得的 /e/now/。
  if [ -f web/dist/now/index.html ] && [ -d web/dist/e/now ]; then
    if grep -qF '/e/now/' "$smap"; then
      bad "sitemap 同时推荐了 /now/ 和 /e/now/（同一份内容的两个 URL）"
    elif grep -qE '<loc>[^<]*/now/</loc>' "$smap"; then
      ok "同一份内容的两个 URL 里，sitemap 只推荐 /now/"
    else
      bad "sitemap 里既没有 /now/ 也没有 /e/now/"
    fi
  fi
else
  bad "加了 feed/sitemap 的 fixture 让构建失败了"
fi
rm -f "$ENTRIES/$RAND3.md" "$ENTRIES/$T-out.md"

# ── 13. 构建失败时不能把已发布的产物留在半截状态 ──────────────────────────────
# scripts/publish 存在的理由：astro build 会先清空 outDir，而 outDir 就是线上 docroot。
entry "$T-breaks-build" '---
type: log
visibility: unlisted
created: 2026-01-01
---

ZZ_BREAKS_BUILD'
before=$(find web/dist -name '*.html' 2>/dev/null | wc -l)
scripts/publish >/dev/null 2>&1
after=$(find web/dist -name '*.html' 2>/dev/null | wc -l)
if [ "$before" -eq "$after" ] && [ "$after" -gt 0 ]; then
  ok "构建失败时 publish 不动已发布的产物（$after 个页面还在）"
else
  bad "构建失败后已发布的产物从 $before 个页面变成 $after 个"
fi
if leaks ZZ_BREAKS_BUILD; then
  bad "失败构建的正文残留在了 web/dist 里"
else
  ok "失败构建的正文没有进 web/dist"
fi
rm -f "$ENTRIES/$T-breaks-build.md"

# ── 14. 标签页：只由公开条目聚出来 ────────────────────────────────────────────
# 标签页和 feed / sitemap 是同一类东西：一个**猜得到的**页面，把一批条目的 URL 列出来。
# `/t/读书/` 谁都能试，所以里面一旦混进一条 unlisted，它「猜不到」的防护就当场作废。
# 这一组同样是正反都断言：一个空的标签页能让所有「不含 unlisted」的断言轻松通过。
TAGENC=$(python3 -c "import urllib.parse;print(urllib.parse.quote('起居注'))")
RAND4=$(openssl rand -hex 16)
entry "$RAND4" '---
title: ZZ_TAGU_TITLE
type: note
visibility: unlisted
created: 2026-03-01
tags: ["起居注", ZZTAGSECRET]
---

ZZ_TAGU_BODY'
entry "$T-tag-a" '---
title: ZZ_TAG_A 公开的带标签条目
type: post
visibility: public
created: 2026-03-02
tags: ["起居注", ZZUpperTag]
---

ZZ_TAG_A_BODY'
entry "$T-tag-b" '---
type: log
visibility: public
created: 2026-03-03
tags: ["起居注"]
---

ZZ_TAG_B_BODY'
if build >/dev/null; then
  tpage="web/dist/t/起居注/index.html"
  if [ -f "$tpage" ]; then
    ok "中文标签生成了标签页（目录名是原文，链接里做百分号编码）"
  else
    bad "中文标签没有生成 /t/起居注/"
  fi

  # 正例先立住，理由同第 12 组：不然下面「不含 unlisted」的断言对一个空页面也成立。
  if grep -qF "/e/$T-tag-a/" "$tpage" 2>/dev/null && grep -qF "/e/$T-tag-b/" "$tpage" 2>/dev/null; then
    ok "标签页聚齐了这个标签下的公开条目"
  else
    bad "标签页漏了公开条目——下面几条「不含 unlisted」的断言因此不算数"
  fi

  # 同一条内容在首页和标签页上必须长得一样。两处版式不同是「完成度不高」最典型的症状，
  # 而它不会有人报 bug——只会让人觉得这站是拼出来的。
  if grep -q 'class="card" data-type=' "$tpage" 2>/dev/null; then
    ok "标签页复用时间流的卡片"
  else
    bad "标签页没有用 .card——同一条内容在两个页面上长得不一样"
  fi

  hit=0
  for marker in "$RAND4" ZZ_TAGU_TITLE ZZ_TAGU_BODY; do
    if grep -rqF "$marker" web/dist/t 2>/dev/null; then
      bad "unlisted 的 '$marker' 出现在了标签页里"; hit=1
    fi
  done
  [ "$hit" -eq 0 ] && ok "unlisted 的 id、标题、正文都不出现在任何标签页里"

  # 只有 unlisted 用过的标签**连页都不该有**：那一页上只可能是它，等于把它念出来。
  if [ -e web/dist/t/zztagsecret ]; then
    bad "只被 unlisted 用过的标签生成了标签页——那一页上只可能有它"
  else
    ok "只被 unlisted 用过的标签不生成标签页"
  fi
  n=$(grep -rlF ZZTAGSECRET web/dist 2>/dev/null | wc -l)
  if [ "$n" -eq 1 ]; then
    ok "unlisted 的标签只出现在它自己那一页"
  else
    bad "unlisted 的标签出现在 $n 个产物里，应当只有 1 个"
  fi

  # 条目页链出去时必须编码。漏掉不会立刻露馅：地址栏里中文照样能打开，
  # 但标签里要是有个 # 或 ?，链接会静静地指向别处。
  if grep -qF "class=\"tag\" href=\"/t/$TAGENC/\"" "web/dist/e/$T-tag-a/index.html" 2>/dev/null; then
    ok "条目页把标签链到 /t/，中文做了百分号编码"
  else
    bad "条目页没有链到 /t/（或者没做百分号编码）"
  fi

  # 大小写归一：ZZUpperTag 和 zzuppertag 是同一个标签，分成两页等于标签没起作用。
  if [ -e web/dist/t/zzuppertag ] && grep -qF 'href="/t/zzuppertag/"' "web/dist/e/$T-tag-a/index.html" 2>/dev/null; then
    ok "标签的大小写归一（Go 和 go 落在同一页）"
  else
    bad "标签没有归一到小写，同一个词会分成两页"
  fi

  # 未列出页上的标签：有页的链出去（单向，泄露不了什么），没页的退化成纯文字而不是死链。
  upage="web/dist/u/$RAND4/index.html"
  if grep -qF 'href="/t/zztagsecret' "$upage" 2>/dev/null; then
    bad "未列出页链向一个不存在的标签页"
  elif grep -qF ZZTAGSECRET "$upage" 2>/dev/null; then
    ok "未列出页上没有标签页的那个标签退化成纯文字"
  else
    bad "未列出页上没有渲染出标签"
  fi
else
  bad "带标签的条目让构建失败了"
fi
rm -f "$ENTRIES/$RAND4.md" "$ENTRIES/$T-tag-a.md" "$ENTRIES/$T-tag-b.md"

# ── 15. 标签的形状：路由参数就是目录名，不能让它跑到 /t/ 外面去 ────────────────
# tags 没有任何形状校验（server/write.go 只做 YAML 转义），而 getStaticPaths 的参数
# 会直接变成 dist 下的路径。`..` 那一条最狠：/t/../index.html 正好盖掉首页。
entry "$T-tag-space" '---
type: log
visibility: public
created: 2026-03-04
tags: ["标签 带空格"]
---

ZZ_TAGSPACE_BODY'
if build >/dev/null; then
  if [ -d "web/dist/t/标签-带空格" ]; then
    ok "带空格的标签折成 - 之后仍是一个合法路径段"
  else
    bad "带空格的标签没生成出 /t/标签-带空格/"
  fi
else
  bad "带空格的标签让构建失败了——它应当被折成 -，不是被拒绝"
fi
rm -f "$ENTRIES/$T-tag-space.md"

i=0
# `a/b` 现在不在这一批里：tagSlug 会把除字母数字中文以外的字符折成 `-`，
# 于是它变成 `a-b`，是一个完全正常的标签。剩下这两个折完之后什么都不剩，
# 做不出 URL 里的一段，只能大声失败。
for badtag in '".."' '"   "'; do
  i=$((i + 1))
  name="$T-tagbad-$i"
  entry "$name" "---
type: log
visibility: public
created: 2026-03-05
tags: [$badtag]
---

ZZ_TAGBAD_BODY"
  if out=$(build); then
    bad "标签 $badtag 居然构建通过了——它会让产物落在 /t/ 之外"
  elif ! grep -qF "$name" <<<"$out"; then
    bad "标签 $badtag 让构建失败了，但没说清是哪一条"
  else
    ok "标签 $badtag 让构建失败，并指出是哪一条"
  fi
  rm -f "$ENTRIES/$name.md"
done
# 反过来：含 `/`、`#`、`&` 这类字符的标签**不该**失败，它们会被折成安全的 slug。
# 关键是折完之后产物仍然落在 /t/ 里面——这是 tagSlug 存在的全部理由。
entry "$T-tagfold" '---
type: log
visibility: public
created: 2026-03-06
tags: ["a/b", "前端 & 后端"]
---

ZZ_TAGFOLD_BODY'
if build >/dev/null; then
  if [ -d web/dist/t/a-b ] && [ -d "web/dist/t/前端-后端" ]; then
    ok "含 / 和 & 的标签被折成安全 slug，产物落在 /t/ 内"
  else
    bad "折叠后的标签页没有落在 /t/a-b/ 和 /t/前端-后端/：$(find web/dist/t -maxdepth 1 -mindepth 1 -printf "%f\n" 2>/dev/null | tr '\n' ' ')"
  fi
else
  bad "含 / 的标签让构建失败了——它应当被折成 a-b，而不是被拒绝"
fi
rm -f "$ENTRIES/$T-tagfold.md"

if [ -e t ] || [ -e web/t ]; then
  bad "构建在 dist 外面写出了 t/ 目录"
else
  ok "非法标签没有在 dist 外面写出任何东西"
fi

# ── 16. 上下篇：条目页不能是死胡同，但 /u/ 上一条都不能有 ─────────────────────
# 前半是可用性，后半是安全性质，放在一起是因为它们是同一段代码的两面：
# /e/ 上有上下篇是对的，/u/ 上有就等于把整批未列出条目串成一条链——
# 我发出去一条链接，对方顺着点就拿到了全部。
RAND5=$(openssl rand -hex 16)
RAND6=$(openssl rand -hex 16)
entry "$T-nav-new" '---
title: ZZ_NAV_NEW 最新的一条
type: post
visibility: public
created: 2099-01-02
---

ZZ_NAV_NEW_BODY'
entry "$T-nav-mid" '---
title: ZZ_NAV_MID 中间那条
type: log
visibility: public
created: 2099-01-01
---

ZZ_NAV_MID_BODY'
entry "$T-nav-old" '---
title: ZZ_NAV_OLD 最旧的一条
type: note
visibility: public
created: 1990-01-01
---

ZZ_NAV_OLD_BODY'
entry "$RAND5" '---
title: ZZ_NAV_U1
type: log
visibility: unlisted
created: 2099-01-03
---

ZZ_NAV_U1_BODY'
entry "$RAND6" '---
title: ZZ_NAV_U2
type: log
visibility: unlisted
created: 1990-01-02
---

ZZ_NAV_U2_BODY'
if build >/dev/null; then
  newpage="web/dist/e/$T-nav-new/index.html"
  midpage="web/dist/e/$T-nav-mid/index.html"
  oldpage="web/dist/e/$T-nav-old/index.html"

  # 最新那条的「更旧的」指向 mid，而 new 是 post、mid 是 log——上下篇跨 type 串，
  # 不按 type 分组：首页就是一条混合流，从那里点进来的人期待的下一条就是流里的下一条。
  if grep -qF "rel=\"next\" href=\"/e/$T-nav-mid/\"" "$newpage" 2>/dev/null; then
    ok "条目页有「更旧的」链接，且跨 type 串（post → log）"
  else
    bad "条目页没有指向流里下一条的链接"
  fi
  if grep -q 'rel="prev"' "$newpage" 2>/dev/null; then
    bad "最新的一条居然有「更新的」链接"
  else
    ok "最新的一条没有「更新的」"
  fi
  if grep -q 'rel="prev"' "$oldpage" 2>/dev/null && ! grep -q 'rel="next"' "$oldpage" 2>/dev/null; then
    ok "最旧的一条只有「更新的」，没有「更旧的」"
  else
    bad "最旧的一条的上下篇不对（应当只有「更新的」）"
  fi
  if grep -q 'rel="prev"' "$midpage" 2>/dev/null && grep -q 'rel="next"' "$midpage" 2>/dev/null; then
    ok "中间的条目两头都有"
  else
    bad "中间的条目缺了一头"
  fi

  u1="web/dist/u/$RAND5/index.html"
  u2="web/dist/u/$RAND6/index.html"
  if grep -qE 'class="pager"|rel="(prev|next)"' "$u1" 2>/dev/null || grep -qE 'class="pager"|rel="(prev|next)"' "$u2" 2>/dev/null; then
    bad "未列出页上有上下篇——拿到一条链接的人能顺着点完全部未列出条目"
  else
    ok "未列出页上没有上下篇"
  fi
  if grep -qF "$RAND6" "$u1" 2>/dev/null || grep -qF "$RAND5" "$u2" 2>/dev/null; then
    bad "一条未列出条目的页面里出现了另一条的 id"
  else
    ok "未列出条目之间互不引用（一条链接只换一条内容）"
  fi
else
  bad "上下篇的 fixture 让构建失败了"
fi
rm -f "$ENTRIES/$T-nav-new.md" "$ENTRIES/$T-nav-mid.md" "$ENTRIES/$T-nav-old.md" \
      "$ENTRIES/$RAND5.md" "$ENTRIES/$RAND6.md"

# ── 17. head 里的分享与发现：OG、图标、订阅入口 ──────────────────────────────
# 这三样都不会有人报 bug，只会让人觉得这站没做完：分享到微信 / Telegram / Slack 是
# 一行裸 URL 而不是一张卡、标签页上是空白图标（外加每次访问一条 /favicon.ico 的 404）、
# 阅读器发现不了 feed。而它们全在 <head> 里——肉眼验收永远看不到那一段。
RAND7=$(openssl rand -hex 16)
entry "$T-head" '---
title: ZZ_HEAD_TITLE 一条长文
type: post
visibility: public
created: 2026-04-01
---

ZZ_HEAD_BODY 这条用来看条目页的 head。'
entry "$RAND7" '---
title: ZZ_HEAD_U_TITLE
type: log
visibility: unlisted
created: 2026-04-02
---

ZZ_HEAD_U_BODY'
if build >/dev/null; then
  home=web/dist/index.html
  page="web/dist/e/$T-head/index.html"
  upage="web/dist/u/$RAND7/index.html"

  miss=""
  for m in 'property="og:type"' 'property="og:title"' 'property="og:description"' \
           'property="og:url"' 'property="og:site_name"' 'name="twitter:card" content="summary"'; do
    grep -qF "$m" "$home" || miss="$miss $m"
  done
  if [ -z "$miss" ]; then ok "首页 head 里 og:* 与 twitter:card 齐全"
  else bad "首页 head 缺:$miss"; fi

  # 抓取端拿到的是这一段 HTML，不是浏览器的地址栏——相对地址它拼不出绝对 URL。
  if grep -qF 'property="og:url" content="https://' "$home"; then
    ok "og:url 是绝对 URL"
  else
    bad "og:url 不是绝对 URL（抓取端拼不出来）"
  fi

  # 全站一律 website 的话，抓取端分不出「这是一个站」和「这是站上的一条东西」。
  if grep -qF 'property="og:type" content="article"' "$page" 2>/dev/null &&
     grep -qF 'property="og:type" content="website"' "$home"; then
    ok "条目页 og:type=article，首页 og:type=website"
  else
    bad "og:type 没有按页面分（条目页应当是 article）"
  fi

  # 标题必须跟着页面走。整站一个标题的 OG 比没有 OG 更糟：每条分享出去都长得一样。
  if grep -qF 'property="og:title" content="ZZ_HEAD_TITLE 一条长文 · cairn"' "$page" 2>/dev/null; then
    ok "og:title 跟着这一页的标题走"
  else
    bad "条目页的 og:title 不是这一条的标题"
  fi

  if grep -qF 'rel="icon" type="image/svg+xml" href="data:image/svg+xml,' "$home"; then
    ok "favicon 是内联 SVG 的 data URI（零文件、零请求）"
  else
    bad "head 里没有内联 SVG 图标"
  fi

  # 站徽的几何只写一遍（Base.astro 里的 STONES），页眉那块图和标签页图标同源。
  # 各画各的话，改了一处另一处不会报任何错，站徽就悄悄变成两个标志——
  # 而这正是「同一个东西在两处长得不一样」里最不容易发现的一种。
  # 页眉是 inline <svg>（原文），favicon 是 data URI（编码过），所以两边分开数。
  if grep -qF 'x="12.6" y="3.2"' "$home" && grep -qF 'x%3D%2212.6%22%20y%3D%223.2%22' "$home"; then
    ok "页眉字标和 favicon 画的是同一堆石头"
  else
    bad "页眉的站徽和 favicon 不是同一个图形（几何被抄成了两份）"
  fi

  if grep -qF 'rel="alternate" type="application/atom+xml"' "$home"; then
    ok "head 里有 feed 的 rel=alternate（阅读器唯一的发现入口）"
  else
    bad "head 里没有指向 feed.xml 的 rel=alternate"
  fi

  # unlisted 页面**照样**有 og：og:url 就是这一页自己的地址，而拿得到这一页的人
  # 手里本来就有它（不然打不开）。真正把秘密递出去的是「猜得到的页面列出别人的 URL」，
  # og 不属于那一类。但两件事互不替代——noindex 必须还在，随机路径也不能因为
  # 多了这几行标签就漏进任何别的产物。
  if grep -q 'name="robots" content="noindex, nofollow"' "$upage" 2>/dev/null &&
     grep -qF "property=\"og:url\" content=\"https://example.com/u/$RAND7/\"" "$upage" 2>/dev/null; then
    ok "未列出页有 og，但 noindex 仍在，且 og:url 就是它自己"
  else
    bad "未列出页的 og / noindex 不对"
  fi
  hits=$(grep -rlF "$RAND7" web/dist 2>/dev/null | wc -l)
  if [ "$hits" -eq 1 ]; then
    ok "加了 og 之后，unlisted 的路径仍然只出现在它自己那一页"
  else
    bad "unlisted 的路径出现在 $hits 个产物里，应当只有 1 个"
  fi
else
  bad "head 那一组的 fixture 让构建失败了"
fi
rm -f "$ENTRIES/$T-head.md" "$ENTRIES/$RAND7.md"

# ── 18. 影像卡：图要真的出现，而且不能是抠出来的裸相对路径 ────────────────────
# photo 是六型里唯一「内容就是那张图」的一支，而卡片上原先从不出现图像。
# 这一组同时钉住两头：绝对路径 / 远程图要铺出来，相对路径**必须**被丢掉——
# 卡片上的 src 是从正文原文正则抠出来的，一个字都没经过 Astro 的图片管线，
# 相对路径印出去就是一张 404 的坏图（见 entries.ts 的 firstImage）。
PIC="$ENTRIES/$T-pic.png"
MADE+=("$PIC")
# 一张 1×1 PNG。只是给相对路径一个真实的落点：Astro 的图片管线遇到指不到文件的
# 相对路径会直接让构建失败，那样这条 fixture 测的就不是它该测的东西了。
printf '%s' 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==' | base64 -d > "$PIC"
entry "$T-photo" '---
title: ZZ_PHOTO_TITLE
type: photo
visibility: public
created: 2026-05-02
---

![ZZ_SHOT_ALT](/zz-shot-abs.png)

ZZ_PHOTO_TAIL'
entry "$T-photo-rel" "---
title: ZZ_PHOTOREL_TITLE
type: photo
visibility: public
created: 2026-05-01
---

![ZZ_RELALT](./$T-pic.png)"
RAND8=$(openssl rand -hex 16)
entry "$RAND8" '---
title: ZZ_UPHOTO_TITLE
type: photo
visibility: unlisted
created: 2026-05-03
---

![ZZ_UPHOTO_ALT](/zz-unlisted-shot.png)'
if build >/dev/null; then
  home=web/dist/index.html

  if grep -qF '<div class="shot">' "$home" && grep -qF 'src="/zz-shot-abs.png"' "$home"; then
    ok "影像卡上真的有 <img>（绝对路径的图）"
  else
    bad "影像卡上没有图——photo 是唯一「内容就是那张图」的一支"
  fi
  # 抠出来的是裸 src，没有宽高，位置只能由 CSS 预留。少了 aspect-ratio，
  # 图一到就把它下面所有的卡往下顶——一次滚动里连跳好几次。
  # aspect-ratio 断在源码上：产物里的 CSS 是压过的，写法随打包器的版本变。
  if grep -qF 'loading="lazy"' "$home" &&
     grep -qF 'aspect-ratio: 3 / 2' web/src/styles/global.css; then
    ok "图有 loading=lazy，且 CSS 用 aspect-ratio 预留了位置"
  else
    bad "图缺 loading=lazy 或没预留位置——图一到就会把下面所有卡往下顶"
  fi

  n=$(grep -o 'class="shot"' "$home" | wc -l)
  if [ "$n" -eq 1 ]; then
    ok "相对路径的图不上卡片（只有绝对路径那一张铺了出来）"
  else
    bad "首页上有 $n 张卡片图，应当只有 1 张（相对路径那条不该铺）"
  fi
  if grep -qF "$T-pic.png" "$home"; then
    bad "裸相对路径被印进了首页的 <img src>——那是一张 404 的坏图"
  else
    ok "裸相对路径一个字都没进首页"
  fi
  # 反过来立住：相对图本身是好的，条目页上它走 <Content /> 进了 Astro 的图片管线。
  # 少了这一条，上面两句对「图根本没生成」也成立。
  if grep -qE '<img[^>]+src="/_astro/' "web/dist/e/$T-photo-rel/index.html" 2>/dev/null; then
    ok "同一张相对图在条目页上是好的（走图片管线，src 指向 /_astro/）"
  else
    bad "相对图在条目页上也没渲染出来——这组断言因此不算数"
  fi

  # 图上面印一遍说明、下面再把同一句当摘要印一遍，是这版之前首页最难看的那种重复。
  if grep -qF 'ZZ_SHOT_ALT' "$home"; then
    bad "有图的影像卡还把 alt 当摘要印了一遍"
  else
    ok "有图时不再把 alt 当摘要渲染一遍"
  fi

  # 卡片图是一类新产物：它把一个 URL 印在一个猜得到的页面上。
  # unlisted 的图只能出现在它自己那一页。
  hits=$(grep -rlF '/zz-unlisted-shot.png' web/dist 2>/dev/null | wc -l)
  if [ "$hits" -eq 1 ]; then
    ok "unlisted 影像的图只出现在它自己那一页"
  else
    bad "unlisted 影像的图出现在 $hits 个产物里，应当只有 1 个"
  fi
else
  bad "影像 fixture 让构建失败了"
fi
rm -f "$ENTRIES/$T-photo.md" "$ENTRIES/$T-photo-rel.md" "$ENTRIES/$RAND8.md" "$PIC"

# ── 19. 目录：只给够长的长文 ─────────────────────────────────────────────────
# 一条短记加目录是笑话，一篇两节的文章加目录也是——目录比它省下的翻页还长。
entry "$T-toc" '---
title: ZZ_TOC_TITLE
type: post
visibility: public
created: 2026-06-03
---

开头一段。

## ZZTOCONE

一段。

## ZZTOCTWO

一段。

### ZZTOCSUB

一段。

#### ZZTOCDEEP

一段。'
entry "$T-toc-short" '---
title: ZZ_TOCSHORT_TITLE
type: post
visibility: public
created: 2026-06-02
---

## ZZSHORTA

一段。

## ZZSHORTB

一段。'
entry "$T-toc-note" '---
title: ZZ_TOCNOTE_TITLE
type: note
visibility: public
created: 2026-06-01
---

## ZZNOTEA

一段。

## ZZNOTEB

一段。

## ZZNOTEC

一段。'
if build >/dev/null; then
  long="web/dist/e/$T-toc/index.html"
  if grep -qF 'class="toc"' "$long" 2>/dev/null &&
     grep -qF 'href="#zztocone"' "$long" &&
     grep -qF 'href="#zztoctwo"' "$long" &&
     grep -qF 'href="#zztocsub"' "$long"; then
    ok "三节以上的长文有目录，h2/h3 都在里面"
  else
    bad "长文没有目录（或漏了 h2/h3）"
  fi
  # h4 多半是列举，铺进来目录会比正文的骨架还碎。锚点只有目录会生成，所以这样判得准。
  if grep -qF 'href="#zztocdeep"' "$long" 2>/dev/null; then
    bad "目录收了 h4——那一层是列举，不是骨架"
  else
    ok "目录只收 h2/h3，不收更深的层级"
  fi
  if grep -qF 'class="toc"' "web/dist/e/$T-toc-short/index.html" 2>/dev/null; then
    bad "只有两节的长文也加了目录"
  else
    ok "只有两节的长文不加目录"
  fi
  if grep -qF 'class="toc"' "web/dist/e/$T-toc-note/index.html" 2>/dev/null; then
    bad "非 post 的条目加了目录——一条笔记 / 短记加目录是笑话"
  else
    ok "只有 post 才有目录"
  fi
else
  bad "目录 fixture 让构建失败了"
fi
rm -f "$ENTRIES/$T-toc.md" "$ENTRIES/$T-toc-short.md" "$ENTRIES/$T-toc-note.md"

# ── 20. 年份标记：时间锚点，而且不能被时区带偏、不能干扰筛选 ──────────────────
# 这一组**故意在 UTC 以西的时区构建**。frontmatter 里的 created 是纯日期，
# z.coerce.date() 按 UTC 午夜解析——用 getFullYear() 的话，`2097-01-01` 在洛杉矶
# 会被读成 2096，于是构建机器换个时区首页就凭空少一个年份，而卡片上的日期还写着 2097。
# entries.ts 的 formatDate 早就因为同一个理由用 getUTC*，两处必须一致。
entry "$T-yr-new" '---
title: ZZ_YR_NEW
type: log
visibility: public
created: 2098-06-01
---

ZZ_YR_NEW_BODY'
entry "$T-yr-jan" '---
title: ZZ_YR_JAN
type: log
visibility: public
created: 2097-01-01
---

ZZ_YR_JAN_BODY'
entry "$T-yr-old" '---
title: ZZ_YR_OLD
type: log
visibility: public
created: 2096-06-01
---

ZZ_YR_OLD_BODY'
if (cd web && TZ=America/Los_Angeles npm run build) >/dev/null 2>&1; then
  home=web/dist/index.html
  miss=""
  for y in 2098 2097 2096; do
    grep -qF "aria-hidden=\"true\"><span>$y</span>" "$home" || miss="$miss $y"
  done
  if [ -z "$miss" ]; then
    ok "年份标记出现了，且在 UTC 以西的时区里不跑偏（getUTCFullYear）"
  else
    bad "缺年份标记:$miss（用 getFullYear 的话 2097-01-01 在洛杉矶会被读成 2096）"
  fi
  if grep -qF '>2097-01-01<' "$home"; then
    ok "卡片上的日期和年份标记同源（都按 UTC 取）"
  else
    bad "卡片日期和年份标记对不上——机器读到的和人看到的不一致"
  fi

  # 一年一个标记，不是一条一个。真实内容里 2026 年有好几条，
  # 「每张卡都插一个」这个 bug 只有在这里才看得出来。
  n=$(grep -o '><span>2026</span>' "$home" | wc -l)
  if [ "$n" -eq 1 ]; then
    ok "同一年只插一个标记（不是每张卡一个）"
  else
    bad "2026 年出现了 $n 个年份标记，应当只有 1 个"
  fi

  # aria-hidden：每张卡自己带完整日期，年份是给眼睛扫读的锚点。留在无障碍树里的话，
  # 读屏器会在列表中间念出一串裸年份，还会让「共 N 项」和筛选播报的条数对不上。
  if grep -qF '<li class="yearmark" aria-hidden="true">' "$home"; then
    ok "年份标记对读屏器隐藏（列表项数仍等于卡片数）"
  else
    bad "年份标记没有 aria-hidden，会被当成一条内容念出来"
  fi
else
  bad "年份 fixture 在 TZ=America/Los_Angeles 下让构建失败了"
fi
rm -f "$ENTRIES/$T-yr-new.md" "$ENTRIES/$T-yr-jan.md" "$ENTRIES/$T-yr-old.md"

# 年份标记是顶层 <li>，会落进筛选脚本手里——第 8、11 组已经钉住「筛选只动 .card」。
# 这里补最后一环：它自己被隐藏时得真的消失。和 .filters 同一个坑，
# 作者样式里的 display:flex 无论特异性高低都会赢 UA 的 [hidden]{display:none}，
# 少了这一条，筛选之后「底下一张卡都不剩」的年份标记照样浮在那儿。
if grep -q "\.yearmark\[hidden\] { display: none; }" web/src/styles/global.css; then
  ok "年份标记的 hidden 真的生效（筛空的年份会消失）"
else
  bad "\.yearmark 的 display:flex 盖掉了 hidden，筛完会留下底下没有卡片的年份"
fi

# 上一条只钉住了 CSS 里有那条规则。JS 有没有真的去设那个 hidden 是另一回事——
# 实测把 `marker.hidden = !kept` 改成 `marker.hidden = false` 时全套断言依然全绿，
# 而线上表现是「按文章筛完，一个底下一张卡都没有的年份还浮在那儿」。
if grep -q "marker.hidden = !kept" web/src/pages/index.astro; then
  ok "年份标记会跟着它底下还剩几张卡一起隐藏"
else
  bad "筛选脚本没把年份标记的 hidden 记账进去，筛空的年份会留在页面上"
fi


# ── 21. /ai 数据模块：产出的 JSON 里不能有任何原文 ───────────────────────────
#
# web/src/data/ai.json 的原料是 ~/.claude/projects 下的 transcript——真实对话、绝对路径、
# 偶尔还有贴进终端的密钥——而这个文件**要进公开的代码仓**（构建机器上没有 transcript，
# 读不到就只能带着走）。所以「里面没有原文」不是一条口头约定，是一条要有断言的安全性质，
# 和第 1 组的「private 不进 dist」是同一类东西：漏了不会有人报 bug，它只是一直公开着。
#
# 采集器自己有一道出口闸门（pipeline/ai/gate.go），写盘前拦。这里是第二道，查的是
# **已经躺在仓库里的那个文件**：它可能被手改过，可能是加闸门之前生成的，也可能是
# 从别的机器上合并过来的。第一道守写入的那一刻，这一道守仓库的状态。
#
# 判据和闸门一样是白名单，而且白到「这份文档里根本没有能装下自由文本的位置」：
# 字符串值只能是日期，键只能是写死的字段名 / 八个类别名 / 日期，数值只能是整数。
# 黑名单（「扫一遍看看有没有像密钥的东西」）永远漏，白名单不会。
ai_scan() { # ai_scan <json> —— 有问题就打印原因并以非零退出
  node -e '
const fs = require("fs");
// 和 pipeline/ai/gate.go 的 schemaKeys / toolClasses 手抄一份。
// 抄而不是共享：这两处是互相独立的两道闸门，共享一份白名单的话，
// 往白名单里加一行就能同时把两道都打开。
const KEYS = new Set([
  "schema", "updated", "tzOffsetHours", "days",
  "seen", "prompts", "promptChars", "turns", "toolCalls", "toolErrors", "tools",
  "bashCmds", "bashPiped", "bashLen", "leverage", "leverageCalls", "hours",
  "tokens", "projects",
  "in", "cacheRead", "cacheCreate", "out", "thinking",
  "count", "topPermille",
  // 工具类别名。它们是写死在采集器里的封闭集合，不是从数据里长出来的。
  "执行", "读文件", "改文件", "派活", "外网", "外部服务", "问我", "其他",
]);
const DATE = /^\d{4}-\d{2}-\d{2}$/;
const clip = (s) => (s.length > 12 ? s.slice(0, 12) + "…" : s);
const bad = [];
function walk(v, path) {
  if (v === null) return bad.push(path + " 是 null");
  if (Array.isArray(v)) return v.forEach((x, i) => walk(x, path + "[" + i + "]"));
  if (typeof v === "object") {
    for (const [k, x] of Object.entries(v)) {
      if (!DATE.test(k) && !KEYS.has(k)) bad.push(path + " 里有不该出现的键 " + JSON.stringify(clip(k)));
      walk(x, path + "." + k);
    }
    return;
  }
  if (typeof v === "string") {
    if (!DATE.test(v)) bad.push(path + " 是一段自由文本 " + JSON.stringify(clip(v)));
    return;
  }
  if (typeof v === "number") {
    if (!Number.isInteger(v)) bad.push(path + " = " + v + " 不是整数");
    return;
  }
  bad.push(path + " 是 " + typeof v);
}
walk(JSON.parse(fs.readFileSync(process.argv[1], "utf8")), "$");
if (bad.length) { console.log(bad.slice(0, 5).join("；")); process.exit(1); }
' "$1"
}

if [ ! -f "$AI_JSON" ]; then
  bad "$AI_JSON 不在。先跑一次 \`cd pipeline && go run ./ai\`"
else
  if why=$(ai_scan "$AI_JSON"); then
    ok "ai.json 里没有原文：字符串只有日期、键只有写死的那几个、数值全是整数"
  else
    bad "ai.json 里有不该出现的东西：$why"
  fi

  # —— 变异验证 ——
  # 上面那条断言只能证明「这一份文件是干净的」，证明不了「扫描器真的会抓」。
  # 所以现场造三份脏的：一段命令原文、一个绝对路径当键、一个存下来的比率。
  # 三份都必须被同一个扫描器拦住；有一份漏了，上面那条绿灯就是假的。
  poison=$(mktemp -d)
  node -e '
const fs = require("fs");
const src = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
const day = Object.keys(src.days)[0];
const w = (name, f) => { const c = JSON.parse(JSON.stringify(src)); f(c); fs.writeFileSync(process.argv[2] + "/" + name, JSON.stringify(c)); };
if (!day) { console.error("ai.json 里一天都没有，变异验证做不了"); process.exit(2); }
w("cmd.json",  (c) => { c.days[day].note = "grep -r AKIA /home/z/私密项目/.env | head"; });
w("path.json", (c) => { c.days[day].tools["/home/z/私密项目"] = 3; });
w("mcp.json",  (c) => { c.days[day].tools["mcp__gitcode__create_pull_request_comment"] = 3; });
w("ratio.json",(c) => { c.days[day].seen = 0.42; });
' "$AI_JSON" "$poison"
  caught=0
  for m in cmd path mcp ratio; do
    if ai_scan "$poison/$m.json" >/dev/null 2>&1; then
      bad "变异验证：扫描器放行了 $m.json（这条断言是空转的）"
    else
      caught=$((caught + 1))
    fi
  done
  [ "$caught" -eq 4 ] && ok "变异验证：命令原文、绝对路径、MCP 工具名、比率，四种脏数据都被拦住"
  rm -rf "$poison"

  # 这个文件必须进得了 git。根 .gitignore 里那条 `data/` 没有前导斜杠的话，
  # 它会连 web/src/data/ 一起忽略掉——于是本机看着一切正常，CI 和别的机器上
  # 根本没有这份数据。这类「只在别处坏」的事，只有断言抓得住。
  if git check-ignore -q "$AI_JSON" 2>/dev/null; then
    bad "$AI_JSON 被 .gitignore 忽略了：它进不了仓库，构建机器上就没有这份数据"
  else
    ok "ai.json 不被 gitignore（构建机器上没有 ~/.claude/projects，只能靠它进仓库）"
  fi
fi

# 页面：图可以少，结论不能少。pipeline/README.md 的铁律是
# 「每个数据模块必须回答一个具体问题并配一句结论」，做出一堆图表却说不出结论 = 没做。
# 所以这里数的是 .take（结论）的条数，不是图的条数。
if [ -f web/dist/ai/index.html ]; then
  takes=$(grep -o 'class="take"' web/dist/ai/index.html | wc -l | tr -d ' ')
  if [ "$takes" -ge 6 ]; then
    ok "/ai 上有 $takes 句结论（每张图配一句，不是配一个图例）"
  else
    bad "/ai 上只有 $takes 句结论，图表比结论多——那就是「做出一堆图表但说不出结论」"
  fi

  # 页面上不能出现任何绝对路径。正文里提到的都是仓库内的相对路径
  #（pipeline/ai/gate.go 这种），一旦出现 /home /Users /workspace /root，
  # 那只可能是某个项目名或文件路径从数据里漏到了渲染上。
  hit=""
  for pat in '/home/' '/Users/' '/workspace/' '/root/'; do
    grep -qF "$pat" web/dist/ai/index.html && hit="$hit $pat"
  done
  if [ -z "$hit" ]; then
    ok "/ai 的产物里没有绝对路径"
  else
    bad "/ai 的产物里出现了绝对路径:$hit"
  fi
else
  bad "没有生成 /ai 页面"
fi

# 分桶的标签数必须和采集器的边界数对得上。差一个不会报任何错，
# 只会让页面上每一个数字都错位一格——「31 次以上」那一格显示的其实是「11–30 次」的数。
for pair in "leverageBounds:LEVERAGE_LABELS" "bashLenBounds:BASH_LEN_LABELS" "promptCharBounds:PROMPT_CHAR_LABELS"; do
  gob=${pair%%:*}; tsl=${pair##*:}
  nb=$(sed -n "s/.*$gob *= *\[\]int{\([^}]*\)}.*/\1/p" pipeline/ai/stat.go | tr ',' '\n' | grep -c '[0-9]')
  nl=$(sed -n "s/^export const $tsl = \[\(.*\)\];$/\1/p" web/src/lib/ai.ts | tr ',' '\n' | grep -c "'")
  if [ "$nb" -gt 0 ] && [ "$nl" -eq $((nb + 1)) ]; then
    ok "$tsl 有 $nl 个标签，对上 $gob 的 $nb 个边界"
  else
    bad "$tsl 有 $nl 个标签，而 $gob 有 $nb 个边界（应当是边界数 + 1）"
  fi
done

# 空快照：构建不能失败，页面不能出现 NaN。
# 这条路径是真会走到的——采集器在一台没有 transcript 的机器上跑出来的就是空快照，
# 而这一页上十几个百分比的分母全部来自这份数据。少写一句「分母为 0 就返回 0」，
# 线上看到的就是一排 NaN%。
AI_BACKUP=$(mktemp)
cp "$AI_JSON" "$AI_BACKUP"

# 一天都没有：这一页该说「还没有采集过」，而不是画一堆零。
printf '%s\n' '{ "schema": 1, "updated": "2026-01-01", "tzOffsetHours": 8, "days": {} }' > "$AI_JSON"
if build >/dev/null 2>&1; then
  if grep -qF '还没有采集过' web/dist/ai/index.html; then
    ok "一天都没有时 /ai 说的是「还没有采集过」，不是一页零"
  else
    bad "空快照下 /ai 没有给出「还没采集」的提示"
  fi
else
  bad "空快照让构建失败了——CI 上第一次拿到这个仓库时就是这个状态"
fi

# 有记录、但某一类计数是零。这才是真会碰上的那种零：
# 换一台机器、换一个人，「这两周一条 bash 都没跑」完全可能，
# 而 bashTotal 是三个百分比的分母。少写一句「分母为 0 就返回 0」，
# 页面上就是一排 NaN%——而且这一条不能用「一天都没有」去测：
# 那条路径根本不渲染图，十几个百分比一个都没算过。
# 从**备份**里取，不从 $AI_JSON 取：上一段刚把它换成了「一天都没有」，
# 再从那份里挑第一天会挑到 undefined，node 静静地抛异常、文件原样没改，
# 于是下面这条断言在一份空快照上绿着——实测就是这么绿的。
if ! node -e '
const fs = require("fs");
const s = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const date = Object.keys(s.days)[0];
if (!date) { console.error("备份里一天都没有"); process.exit(2); }
const d = s.days[date];
// 留着 prompts 和 seen（好让这一天算「有记录」），把所有会当分母的计数清零。
d.turns = 0; d.toolCalls = 0; d.toolErrors = 0; d.tools = {};
d.bashCmds = 0; d.bashPiped = 0;
d.bashLen = d.bashLen.map(() => 0);
d.leverage = d.leverage.map(() => 0);
d.leverageCalls = d.leverageCalls.map(() => 0);
d.hours = d.hours.map(() => 0);
d.tokens = { in: 0, cacheRead: 0, cacheCreate: 0, out: 0, thinking: 0 };
d.projects = { count: 0, topPermille: 0 };
s.days = { [date]: d };
fs.writeFileSync(process.argv[1], JSON.stringify(s, null, 2) + "\n");
' "$AI_JSON" "$AI_BACKUP"; then
  bad "造不出「某类计数为 0」的快照，下面两条断言没有真的跑"
fi
if build >/dev/null 2>&1; then
  if grep -q 'NaN' web/dist/ai/index.html; then
    bad "某一类计数为 0 时 /ai 上出现了 NaN（那个比率的分母是 0）"
  else
    ok "某一类计数为 0 时 /ai 上没有 NaN（分母为 0 的比率退回 0%）"
  fi
  if grep -qF 'Infinity' web/dist/ai/index.html; then
    bad "/ai 上出现了 Infinity（有个归一化除了 0）"
  else
    ok "某一类计数为 0 时也没有 Infinity（柱子的归一化除数为 0 时退回 0）"
  fi
else
  bad "一天里某类计数为 0 就让构建失败了"
fi
cp "$AI_BACKUP" "$AI_JSON"        # cp 而不是 mv，理由见 cleanup()
rm -f "$AI_BACKUP"
AI_BACKUP=""


# ── 22. scripts/preflight：查部署前置条件的那个脚本，它自己也要有人查 ─────────
#
# preflight 把 deploy/README.md 的「容易踩的几脚」变成了可执行检查。而一个自检脚本
# 最坏的失败方式不是报错，是**静默地什么都没查还亮绿灯**——scripts/deploy 会把那个
# 退出码 0 当成「查过了，没问题」，然后接着往下装。它查的那些东西（compose 的 volumes、
# ports、Caddyfile 的站点地址）又恰好都在改，一个只认旧写法的解析器不会报错，
# 只会少打印几行。所以这一组查三件事：在这台机器上跑不崩、该报的报得出来、
# 退出码的语义确实是「致命条数」。
#
# 注意断言的**不是「preflight 通过」**：这个工作区没有 .env、没有 docker，
# preflight 一定会报一串错，那是对的。查的是它报得对不对。
PF_TMP=$(mktemp -d)

# 造一份「除了要故意弄坏的地方之外都对」的最小仓库。preflight 的 --root 就是为它准备的：
# 不这么做的话，这些断言就只能在真仓库上跑，而真仓库的状态（有没有 .env、uid 是多少）
# 每台机器都不一样——那样的断言在别人机器上要么假绿要么假红。
pf_fixture() { # pf_fixture <目录>
  local d=$1
  mkdir -p "$d/deploy" "$d/web/content/entries"
  cp deploy/docker-compose.yml deploy/Caddyfile "$d/deploy/"
  # 顺手把占位域名换掉：域名那一节不是这一组要测的东西，让它安静。
  sed 's#https://example\.com#https://pf.test#' web/astro.config.mjs > "$d/web/astro.config.mjs"
  {
    echo "CAIRN_TOKEN=$(openssl rand -hex 32)"
    echo "CAIRN_UID=$(id -u)"
    echo "CAIRN_GID=$(id -g)"
    echo "CAIRN_DOMAIN=pf.test"
    echo "CAIRN_URL=https://pf.test"
  } > "$d/.env"
  chmod 600 "$d/.env"
}

# pf <参数...> —— 跑一次 preflight，输出进 $pf_out、退出码进 $pf_rc、stderr 进 $pf_err
pf() {
  local errf="$PF_TMP/stderr"
  pf_out=$(scripts/preflight "$@" 2>"$errf"); pf_rc=$?
  pf_err=$(cat "$errf")
}
pf_fatals() { printf '%s\n' "$pf_out" | grep -c '✗'; }

# —— 在这台机器上、这个真仓库上，跑不崩 ——
# 「不崩」不等于「退出码不是 1」：set -u 下引用一个没赋值的变量会让 bash 当场退出，
# 而那时它已经打印了半份报告，退出码还可能恰好落在 0-63 里像个正常结果。
# 所以查的是 stderr 干净、六节都跑到了、最后一行是总结。
pf --offline
if [ -n "$pf_err" ]; then
  bad "preflight 往 stderr 上吐了东西（多半是脚本自己崩了）：$(printf '%s' "$pf_err" | head -3 | tr '\n' ' ')"
else
  ok "preflight 在这台机器上跑完，stderr 是干净的"
fi
missing=""
for want in "工具与守护进程：" "端口：" ".env：" "内容目录：" "域名：" "构建与磁盘："; do
  printf '%s\n' "$pf_out" | grep -qF "$want" || missing="$missing $want"
done
if [ -z "$missing" ]; then
  ok "preflight 六节都跑到了（中途没被一个 set -u 打断）"
else
  bad "preflight 少了这几节:$missing —— 它多半是在中间挂了，而不是查完了"
fi
if printf '%s\n' "$pf_out" | tail -1 | grep -qE '(全部通过|条警告|条致命)'; then
  ok "preflight 走到了最后的总结行"
else
  bad "preflight 没有打印总结行：$(printf '%s\n' "$pf_out" | tail -1)"
fi

# —— 退出码 = 致命条数，警告不算 ——
# 这条不写死数字，直接拿输出里 ✗ 的条数去比。写死数字的话，往 preflight 里加一条检查
# 就得来改这里，改法又只有「把 3 改成 4」这一种——那不是断言，是抄答案。
if [ "$pf_rc" = "$(pf_fatals)" ]; then
  ok "preflight 的退出码（$pf_rc）等于 ✗ 的条数（这个仓库现在没有 .env、没有 docker，报错是对的）"
else
  bad "preflight 退出码是 $pf_rc，而输出里有 $(pf_fatals) 条 ✗ —— 退出码的语义对不上"
fi

# —— 该报「没有 docker」的时候报得出来 ——
# 造一个只缺 docker 的 PATH：把当前 PATH 里每个可执行文件都软链进一个临时目录，
# 唯独跳过 docker。为什么不直接把 PATH 清空——那样 sed / awk / git 也一起没了，
# 脚本会因为别的原因崩掉，而这条断言照样绿：它只查「有没有那句话」。
# 这么绕还有一个好处：在**装了 docker** 的机器上（比如部署那台）这条同样跑得动。
pf_shim="$PF_TMP/bin"
mkdir -p "$pf_shim"
for d in ${PATH//:/ }; do
  [ -d "$d" ] || continue
  for f in "$d"/*; do
    b=${f##*/}
    [ "$b" = docker ] && continue
    [ -e "$pf_shim/$b" ] || ln -s "$f" "$pf_shim/$b" 2>/dev/null
  done
done
pf_fixture "$PF_TMP/nodocker"
out=$(PATH="$pf_shim" scripts/preflight --root "$PF_TMP/nodocker" --offline --only tools 2>&1); rc=$?
if printf '%s\n' "$out" | grep -qF "没有 docker" && [ "$rc" -ge 1 ]; then
  ok "PATH 里没有 docker 时，preflight 报「没有 docker」并以非零退出（$rc）"
else
  out=$(printf '%s' "$out" | tr '\n' ' '); bad "PATH 里没有 docker 时 preflight 没报出来（退出码 $rc）：${out:0:160}"
fi

# —— 一份哪儿都对的配置：0 条致命，但有警告，而警告不能把退出码带偏 ——
pf_fixture "$PF_TMP/good"

# —— Caddyfile 里的 {$CAIRN_DOMAIN} 必须传给 caddy validate ——
# 不传就直接验的话，Caddy 报的是「unrecognized global option: encode」：站点地址那一行
# 空了，整个块被当成全局选项块解析。这句报错和真正的原因（域名没配）完全对不上，
# 而「症状和原因对不上」正是 preflight 要消灭的东西——它自己造一个就更说不过去。
# 用一个假的 caddy 来验：真 caddy 是容器里的东西，不能要求每台跑测试的机器上都有一个。
pf_fake="$PF_TMP/fakebin"; mkdir -p "$pf_fake"
cat > "$pf_fake/caddy" <<'FAKECADDY'
#!/bin/sh
[ "$1" = validate ] || exit 0
[ -n "${CAIRN_DOMAIN:-}" ] || { echo "Error: unrecognized global option: encode" >&2; exit 1; }
echo "Valid configuration"
FAKECADDY
chmod +x "$pf_fake/caddy"
out=$(PATH="$pf_fake:$PATH" scripts/preflight --root "$PF_TMP/good" --offline --only build 2>&1)
if printf '%s\n' "$out" | grep -qF "caddy validate 通过"; then
  ok "preflight 把 .env 里的 CAIRN_DOMAIN 传给了 caddy validate"
else
  bad "preflight 没把域名传给 caddy validate：$(printf '%s\n' "$out" | grep -i caddy | tr '\n' ' ' | head -c 200)"
fi
pf_fixture "$PF_TMP/nodomain"
sed 's/^CAIRN_DOMAIN=.*/CAIRN_DOMAIN=/' "$PF_TMP/nodomain/.env" > "$PF_TMP/nodomain/.env.new"
mv "$PF_TMP/nodomain/.env.new" "$PF_TMP/nodomain/.env"
out=$(PATH="$pf_fake:$PATH" scripts/preflight --root "$PF_TMP/nodomain" --offline --only build 2>&1)
if printf '%s\n' "$out" | grep -qF "caddy validate 不通过"; then
  bad "域名还空着时，preflight 报了「caddy validate 不通过」——这会把人带去查 Caddyfile 的语法，而语法没问题"
elif printf '%s\n' "$out" | grep -qF "跳过 caddy validate"; then
  ok "域名还空着时 preflight 跳过 validate 并说明原因，而不是照抄那句对不上的报错"
else
  bad "域名还空着时 preflight 对 caddy validate 什么都没说"
fi
pf --root "$PF_TMP/good" --offline --only env,content,domain
if [ "$pf_rc" -eq 0 ] && printf '%s\n' "$pf_out" | grep -q '!'; then
  ok "配置都对时 preflight 退 0，尽管还有警告（警告不计入退出码：DNS 没生效可以先部署后解析）"
elif [ "$pf_rc" -ne 0 ]; then
  d=$(printf '%s\n' "$pf_out" | grep -A2 '✗' | head -6 | tr '\n' ' '); bad "一份哪儿都对的配置被 preflight 判了 $pf_rc 条致命：${d:0:200}"
else
  bad "这份 fixture 一条警告都没有，「警告不影响退出码」那条断言是空转的"
fi

# —— 三个故意的错，要一个不漏地点名 ——
# 这三条都是 deploy/README.md 里「容易踩的几脚」，共同点是症状和原因对不上：
# 全都表现为「容器无限重启」或「每条写入 500」，而日志里的那句话只在容器里。
pf_fixture "$PF_TMP/broken"
sed -i.bak 's/^CAIRN_TOKEN=.*/CAIRN_TOKEN=tooshort/; s/^CAIRN_UID=.*/CAIRN_UID=nobody/' "$PF_TMP/broken/.env"
rm -f "$PF_TMP/broken/.env.bak"
echo 'CAIRN_TELEGRAM_ALLOW=12345678' >> "$PF_TMP/broken/.env"   # 只配一个 = 半配
pf --root "$PF_TMP/broken" --offline --only env
hit=0
for pat in "CAIRN_TOKEN 只有" "Telegram 只配了一个" "CAIRN_UID / CAIRN_GID 不是纯数字"; do
  printf '%s\n' "$pf_out" | grep -qF "$pat" || { bad "preflight 没报出「$pat」这一类的错"; hit=1; }
done
[ "$hit" -eq 0 ] && ok "token 太短、Telegram 半配、uid 不是数字，三个都被点名"
if [ "$pf_rc" -eq 3 ] && [ "$pf_rc" = "$(pf_fatals)" ]; then
  ok "三个错 → 退出码 3（不是「1」也不是「有问题」，是条数）"
else
  bad "三个故意的错，preflight 退出码是 $pf_rc、✗ 有 $(pf_fatals) 条"
fi

# —— uid 对不上：那个 500 的根因 ——
# 它是这几脚里最难自己看出来的一脚，所以单独钉一条。
pf_fixture "$PF_TMP/uid"
sed "s/^CAIRN_UID=.*/CAIRN_UID=$(( $(id -u) + 12345 ))/" "$PF_TMP/uid/.env" > "$PF_TMP/uid/.env.new"
mv "$PF_TMP/uid/.env.new" "$PF_TMP/uid/.env"
pf --root "$PF_TMP/uid" --offline --only content
if printf '%s\n' "$pf_out" | grep -q '500' && printf '%s\n' "$pf_out" | grep -q 'chown'; then
  ok "内容目录属主和 CAIRN_UID 对不上时，preflight 说出了症状（500）也给了修法（chown）"
else
  bad "uid 对不上时 preflight 没把「每条写入 500」和「怎么改」说清楚"
fi

# —— 内容目录不能整个进到 Caddy 那个容器里 ——
# compose 把 web/ 整层挂进 caddy（挂 dist 会被 publish 的 rename 坑），于是 web/content/
# 底下那些四层可见度的真实条目也跟着进去了，要靠一层空 tmpfs 盖住。
# 「Caddyfile 的 root 指向 dist，本来就发不出去」不能算数——那是软的，一行配置写错就破了；
# 「根本不在这个容器里」才是硬的。这和第 1 组「private 不进 dist」是同一条性质，
# 只是发生在部署层：字节不该出现在不需要它的地方。
pf_fixture "$PF_TMP/shadow"
sed 's#\(target:[[:space:]]*/.*\)/content$#\1/content-nowhere#' \
    "$PF_TMP/shadow/deploy/docker-compose.yml" > "$PF_TMP/shadow/deploy/dc.new"
if cmp -s "$PF_TMP/shadow/deploy/dc.new" "$PF_TMP/shadow/deploy/docker-compose.yml"; then
  bad "造不出「遮蔽挂错地方」这个变异（compose 里的 tmpfs target 换写法了？），下面这条断言没有真的跑"
else
  mv "$PF_TMP/shadow/deploy/dc.new" "$PF_TMP/shadow/deploy/docker-compose.yml"
  pf --root "$PF_TMP/shadow" --offline --only content
  if [ "$pf_rc" -ge 1 ] && printf '%s\n' "$pf_out" | grep -q '遮蔽'; then
    ok "遮蔽挂到了别处时 preflight 报致命（内容目录会整个出现在 Caddy 容器里）"
  else
    bad "遮蔽挂错地方，preflight 却放行了（退出码 $pf_rc）"
  fi
fi
# 变异的另一半：没动过的那份必须是绿的，否则上面那条只是「总在报错」。
pf --root "$PF_TMP/good" --offline --only content
if printf '%s\n' "$pf_out" | grep -q '盖住了'; then
  ok "没动过的 compose 上，preflight 认出内容目录被 tmpfs 盖住了"
else
  bad "preflight 在正常的 compose 上没认出那层遮蔽——它多半根本没解析到 volumes"
fi

# —— --only 写错必须停下来，不能默默跑零条检查然后报「全部通过」——
if scripts/preflight --only nosuchsection >/dev/null 2>&1; then
  bad "--only 写了个不存在的节名，preflight 居然退了 0"
else
  rc=$?
  if [ "$rc" -eq 64 ]; then
    ok "--only 写错时退 64（用法错误，和「64 条致命」撞不上：致命数封在 63）"
  else
    bad "--only 写错时退的是 $rc，不是 64"
  fi
fi

# —— 它必须是只读的。一个「部署前自检」如果会改东西，人就不敢在出问题时随手跑它，
#    而那正是最需要跑它的时刻。
before=$(find "$PF_TMP/good" | sort)
pf --root "$PF_TMP/good" --offline
after=$(find "$PF_TMP/good" | sort)
if [ "$before" = "$after" ]; then
  ok "preflight 跑完之后一个文件都没多、没少（写权限探针自己清掉了）"
else
  d=$(diff <(echo "$before") <(echo "$after") | tr '\n' ' '); bad "preflight 动了被检查的目录：${d:0:160}"
fi

# —— 探针必须**被打断时**也留不下东西 ——
# 会留下文件的恰恰是没走到「rm 一下」那一行的那一次：Ctrl-C、`timeout`（发 SIGTERM）、
# CI 超时被杀。留下的后果不是「多一个文件」：内容目录是一个 git 仓库，一个未跟踪的
# 文件就让 `git status --porcelain` 非空，而 scripts/deploy 看到它非空就**跳过
# git pull**，并说「那多半是刚落盘还没 commit 的条目」——内容仓从此静默不再更新。
# 变异验证：直接造一个上次留下的探针，preflight 必须把它扫掉。
touch "$PF_TMP/good/web/content/entries/.preflight-probe-99999"
pf --root "$PF_TMP/good" --offline --only content
if [ -e "$PF_TMP/good/web/content/entries/.preflight-probe-99999" ]; then
  bad "上次留下的写权限探针没被扫掉 —— 内容仓会一直是 dirty，scripts/deploy 会永远跳过 git pull"
elif printf '%s\n' "$pf_out" | grep -q '探针'; then
  ok "上次没删干净的写权限探针被扫掉了，而且说了它为什么要紧"
else
  bad "探针扫掉了，但一声没吭 —— 人不会知道上一次自检是被打断的"
fi
if grep -q 'trap drop_probe EXIT' scripts/preflight; then
  ok "探针的收尾挂在 EXIT trap 上（被 SIGTERM 打断也清得掉）"
else
  bad "preflight 里没有 EXIT trap 收探针：被 timeout / Ctrl-C 打断就会留下一个"
fi

# —— 通配符域名：能签证书 ≠ 能拼进链接 ——
# CAIRN_URL 和 astro 的 site 是**要被拼进链接**的地址（canonical、og:url、sitemap 的
# <loc>、Telegram 的确认链接）。https://*.example.org/ 谁也打不开，而构建不会失败，
# 它照样出整站——真正停下来的地方是三分钟后「首页拿不到 200」，原因写的却是
# 「证书签不下来」。所以这一条必须在 preflight 就拦住。
sed -i.bak 's#^CAIRN_URL=.*#CAIRN_URL=https://*.pf.test#; s#^CAIRN_DOMAIN=.*#CAIRN_DOMAIN=*.pf.test#' "$PF_TMP/good/.env"
rm -f "$PF_TMP/good/.env.bak"
sed -i.bak "s#^const site = .*#const site = 'https://*.pf.test';#" "$PF_TMP/good/web/astro.config.mjs"
rm -f "$PF_TMP/good/web/astro.config.mjs.bak"
pf --root "$PF_TMP/good" --offline --only domain
if [ "$pf_rc" -ge 1 ] && printf '%s\n' "$pf_out" | grep -q '通配符'; then
  ok "CAIRN_URL / site 里的通配符被 preflight 报成致命（canonical 会指向一个打不开的主机）"
else
  bad "通配符域名进了 CAIRN_URL / site，preflight 却放行了（退出码 $pf_rc）"
fi
# 变异的另一半：换成具体域名必须不再报，否则上面那条只是「总在报错」。
sed -i.bak 's#^CAIRN_URL=.*#CAIRN_URL=https://pf.test#; s#^CAIRN_DOMAIN=.*#CAIRN_DOMAIN=pf.test *.pf.test#' "$PF_TMP/good/.env"
rm -f "$PF_TMP/good/.env.bak"
sed -i.bak "s#^const site = .*#const site = 'https://pf.test';#" "$PF_TMP/good/web/astro.config.mjs"
rm -f "$PF_TMP/good/web/astro.config.mjs.bak"
pf --root "$PF_TMP/good" --offline --only domain
if printf '%s\n' "$pf_out" | grep -q '通配符'; then
  bad "把通配符挪到第二个之后 preflight 还在报 —— 它拦的是「有没有 *」，不是「第一个是不是 *」"
else
  ok "通配符放在第二个（只给 Caddy 签证书用）时不报，第一个是具体域名就行"
fi

# —— shell 里 export 的同名变量会盖掉 .env ——
# compose 的**变量插值**取「shell 环境 > --env-file」，而 environment: 段又优先于
# env_file——于是 .env 里那一行完全不起作用，值却看着好好的。这是实测出来的
# （compose v2.39.1），不是照文档写的，所以要有断言钉住 preflight 认得出它。
pf_shadow_out=$(TZ=Zz/Mutant scripts/preflight --root "$PF_TMP/good" --offline --only env 2>&1)
if printf '%s\n' "$pf_shadow_out" | grep -q 'TZ'; then
  ok "shell 里 export 了 TZ 时 preflight 点名说它会盖掉 .env（症状是条目日期差一天）"
else
  bad "shell 里 export 的 TZ 会盖掉 .env，preflight 一声没吭"
fi

# ── 23. scripts/deploy：一键部署脚本自己的性质 ───────────────────────────────
#
# 这个脚本会装东西、会 clone、会起容器、会把密钥写进 .env。它错一次的代价比别的脚本
# 都大，而它又是**最难在开发机上跑一遍**的（这里没有 docker、没有公网域名）。
# 所以只断言那些不需要真 docker 就能证伪的性质：dry-run 的「一个字节都不改」、
# 域名替换的三种走法、通配符、以及密钥不上屏。起容器之后的行为这里一条都验不了，
# 那些断言写在 scripts/deploy 自己的「逐个端点验活」里，只有在真服务器上才跑得到。
echo

dp_out=$(scripts/deploy --help 2>&1)
if printf '%s\n' "$dp_out" | grep -q 'dry-run'; then
  ok "scripts/deploy --help 打得出用法（--dry-run 在里面）"
else
  bad "scripts/deploy --help 没打出用法：$(printf '%s' "$dp_out" | head -1)"
fi

# —— 不认识的参数必须退 64，不能「猜一个默认值往下走」——
if scripts/deploy --no-such-flag >/dev/null 2>&1; then
  bad "scripts/deploy 收到不认识的参数居然退了 0"
else
  rc=$?
  if [ "$rc" -eq 64 ]; then
    ok "不认识的参数退 64（用法错误，和别的退出码撞不上）"
  else
    bad "不认识的参数退的是 $rc，不是 64"
  fi
fi

# 造一份最小仓库。内容目录先 git init 好：不这么做的话脚本会**停下来问**
# 「内容私有仓的 git 地址」——那是它该做的事（宁可停下来问），但会把这一组挂住。
DP_TMP=$(mktemp -d)
mkdir -p "$DP_TMP/repo/deploy" "$DP_TMP/repo/scripts" "$DP_TMP/repo/web/content/entries"
cp deploy/docker-compose.yml deploy/Caddyfile "$DP_TMP/repo/deploy/"
cp scripts/deploy scripts/preflight scripts/publish "$DP_TMP/repo/scripts/"
cp web/astro.config.mjs "$DP_TMP/repo/web/"
git -C "$DP_TMP/repo/web/content/entries" init -q

# —— --dry-run 必须一个字节都不改 ——
# 这是它唯一的承诺，也是这台机器上唯一一条能真验的。做法是按内容哈希 + 类型 + 权限 +
# 大小做全树指纹，跑完再取一次，逐字节比。注意 preflight 是**留着**的：dry-run 会真的
# 调它一次，而 preflight 是这条路径上唯一会往磁盘写东西的一环（内容目录里的写权限
# 探针）。把它拿掉再测，等于绕开了唯一一个可能违约的地方。
dp_snap() { (cd "$DP_TMP/repo" && find . -type f -exec sha256sum {} + 2>/dev/null | sort
             cd "$DP_TMP/repo" && find . -printf '%p\t%y\t%m\t%s\n' 2>/dev/null | sort); }
dp_before=$(dp_snap)
"$DP_TMP/repo/scripts/deploy" --dry-run --no-telegram </dev/null >"$DP_TMP/out" 2>&1
dp_after=$(dp_snap)
if [ "$dp_before" = "$dp_after" ]; then
  ok "scripts/deploy --dry-run 跑完，仓库逐字节没变（内容、类型、权限、大小都比过）"
else
  bad "scripts/deploy --dry-run 改了东西：$(diff <(printf '%s\n' "$dp_before") <(printf '%s\n' "$dp_after") | tr '\n' ' ' | cut -c1-200)"
fi
dp_left=""
for f in .env web/dist web/astro.config.mjs.bak; do
  [ -e "$DP_TMP/repo/$f" ] && dp_left="$dp_left $f"
done
if [ -z "$dp_left" ]; then
  ok "--dry-run 没生成 .env、没构建 dist、没留下 sed 的 .bak"
else
  bad "--dry-run 留下了：$dp_left"
fi
# 而且它得**说出**打算做什么，否则「什么都没改」是靠什么都没做换来的。
if grep -q '生成.*\.env' "$DP_TMP/out" && grep -q 'docker compose' "$DP_TMP/out"; then
  ok "--dry-run 把要做的事列了出来（生成 .env、起容器都在计划里）"
else
  bad "--dry-run 什么都没改，但也几乎什么都没说——那不是 dry-run，是空跑"
fi

# —— 下面几条要走到「占位域名」那一步，而那一步在「手边的工具」后面。
#    这台机器上多半没有 docker，脚本会在第一步就正确地停下来（那是对的行为，
#    上面 preflight 那一组已经断言过「没有 docker 要报出来」）。所以给它一个只会
#    回答版本号的假 docker，把测试的焦点留在域名替换上。假 docker 一个容器也起不了，
#    脚本会在后面的 npm ci 那步失败——那正好，我们要看的东西在那之前。
DP_BIN="$DP_TMP/bin"; mkdir -p "$DP_BIN"
cat > "$DP_BIN/docker" <<'DOCKERSTUB'
#!/bin/sh
case "$1 $2" in
  "compose version") [ "$3" = --short ] && echo 0.0.0-stub || echo "Docker Compose version v0.0.0-stub"; exit 0 ;;
esac
case "$1" in
  --version) echo "Docker version 0.0.0-stub, build stub"; exit 0 ;;
  info) [ "$2" = --format ] && echo 0.0.0-stub; exit 0 ;;
esac
exit 0
DOCKERSTUB
chmod +x "$DP_BIN/docker"
# 自检也从 fixture 里拿掉：它单独有一组（第 22 组），而留着它只会让这几条跑得很慢
# （它要查 DNS、要探公网 IP），却验不到任何新东西。
rm -f "$DP_TMP/repo/scripts/preflight"

dp_site() { sed -n "s/^const site = ['\"]\([^'\"]*\)['\"].*/\1/p" "$DP_TMP/repo/web/astro.config.mjs" | head -1; }
dp_run() { PATH="$DP_BIN:$PATH" "$DP_TMP/repo/scripts/deploy" "$@" </dev/null 2>&1; }

# (a) 还是占位符 → 换掉
dp_run --domain dp.test --no-telegram >/dev/null
if [ "$(dp_site)" = "https://dp.test" ]; then
  ok "占位域名会被换成真域名，而且换完读回来核对过"
else
  bad "占位域名没换成：site 现在是「$(dp_site)」"
fi
# (b) 已经是这个域名 → 幂等，一个字不动。文本替换是整条部署链上最脆的一环：
#     改过一次之后再跑一遍，sed 要么找不到占位符，要么把真域名换成另一个。
dp_h=$(sha256sum "$DP_TMP/repo/web/astro.config.mjs")
dp_run --domain dp.test --no-telegram >/dev/null
if printf '%s' "$dp_h" | sha256sum -c - >/dev/null 2>&1; then
  ok "第二次跑不动 astro.config.mjs（幂等：域名已经换过就跳过）"
else
  bad "第二次跑又改了 astro.config.mjs —— 一键脚本最容易写错的就是这里"
fi
# (c) 有人手改成了另一个真域名 → 必须停下来问，绝不覆盖。
#     两个域名不一致时站是通的，只是每一页都在把权重送给另一个——最难自己发现的那种。
sed -i.bak "s#^const site = .*#const site = 'https://someone-else.test';#" "$DP_TMP/repo/web/astro.config.mjs"
rm -f "$DP_TMP/repo/web/astro.config.mjs.bak"
dp_o=$(dp_run --domain dp.test --no-telegram)
if [ "$(dp_site)" = "https://someone-else.test" ] && printf '%s\n' "$dp_o" | grep -q '既不是占位符'; then
  ok "site 是另一个真域名时停下来问，不覆盖（这一条只有停下来是对的）"
else
  bad "site 是 https://someone-else.test 时脚本把它覆盖了或者没说清楚：现在是「$(dp_site)」"
fi
cp web/astro.config.mjs "$DP_TMP/repo/web/astro.config.mjs"

# —— 第一个域名是通配符 → 拒绝。CAIRN_URL / site / 验活时 curl 的地址都从第一个来，
#    而 https://*.example.org/ 谁也打不开；构建**不会**因此失败（照样出整站），
#    所以只能在这里拦。理由见 deploy/README 的「容易踩的几脚」。
rm -f "$DP_TMP/repo/.env"
dp_o=$(dp_run --domain '*.dp.test' --no-telegram)
if printf '%s\n' "$dp_o" | grep -q '通配符' && [ ! -f "$DP_TMP/repo/.env" ]; then
  ok "第一个域名是通配符时拒绝往下走，也没写出一份带 https://*.… 的 .env"
else
  bad "第一个域名是通配符却放行了 —— canonical 会指向一个打不开的主机，而构建不报错"
fi
# 变异的另一半：具体域名在前、通配符在后必须放行（那是给 Caddy 签证书用的，合法）。
dp_o=$(dp_run --domain 'dp.test *.dp.test' --no-telegram)
if printf '%s\n' "$dp_o" | grep -q '通配符'; then
  bad "通配符放在第二个也被拒了 —— 它拦的是「有没有 *」，不是「第一个是不是 *」"
else
  ok "具体域名在前、通配符在后放行（Caddy 拿整串签证书，别的地方只用第一个）"
fi

# —— 生成的密钥不能出现在终端上。它会进 tee 出来的部署日志、进 CI 的 artifact、
#    进任何一次「把输出贴给别人看」。
rm -f "$DP_TMP/repo/.env"
dp_o=$(dp_run --domain dp.test --no-telegram)
dp_tok=$(sed -n 's/^CAIRN_TOKEN=//p' "$DP_TMP/repo/.env" 2>/dev/null | head -1)
if [ ${#dp_tok} -ne 64 ]; then
  bad "脚本没写出一个 64 位的 CAIRN_TOKEN，下面「密钥没回显」那条断言等于没跑"
elif printf '%s' "$dp_o" | grep -qF "$dp_tok"; then
  bad "生成的 CAIRN_TOKEN 出现在了终端输出里 —— 它会进部署日志、进 CI 的 artifact"
else
  ok "生成的 CAIRN_TOKEN 一个字符都没出现在终端输出里（只在 .env 里）"
fi
dp_mode=$(stat -c %a "$DP_TMP/repo/.env" 2>/dev/null || stat -f %Lp "$DP_TMP/repo/.env" 2>/dev/null)
if [ "$dp_mode" = 600 ]; then
  ok ".env 的权限是 600（同机器上别的用户读不到那两个密钥）"
else
  bad ".env 的权限是 $dp_mode，不是 600"
fi
# 第二次跑必须原样复用那个 token：重新生成不会报错，只会让所有客户端和 bot 同时静默失效。
dp_run --domain dp.test --no-telegram >/dev/null
if [ "$(sed -n 's/^CAIRN_TOKEN=//p' "$DP_TMP/repo/.env" | head -1)" = "$dp_tok" ]; then
  ok "第二次跑不重新生成 CAIRN_TOKEN（重新生成 = 写入通道和 bot 一起静默失效）"
else
  bad "第二次跑把 CAIRN_TOKEN 换掉了 —— 所有 ~/.cairnrc 和 CI 里配着的那个就此失效"
fi
rm -rf "$DP_TMP"

rm -rf "$PF_TMP"
PF_TMP=""


# ── 两份 envget 必须保持同一套逻辑 ──────────────────────────────────────────
# scripts/deploy 和 scripts/preflight 各抄了一份同样的 awk（deploy 会调 preflight，
# source 它会把它跑一遍，所以没法共用）。抄的理由成立，但抄出来的东西会漂移，
# 而漂移的后果是「preflight 说配好了，deploy 读出来是空的」——两边都不报错。
# 只比逻辑，不比注释：注释本来就该各写各的。
strip_comments() { grep -v '^\s*#' | sed 's/[[:space:]]*#.*$//' | sed '/^[[:space:]]*$/d'; }
grab_envget() { sed -n '/^envget()/,/^}/p' "$1" | strip_comments; }
if [ "$(grab_envget scripts/deploy | md5sum)" = "$(grab_envget scripts/preflight | md5sum)" ]; then
  ok "scripts/deploy 与 scripts/preflight 的 envget 逻辑一致"
else
  bad "两份 envget 漂移了 —— preflight 说配好了、deploy 读出来是空的，而两边都不报错"
  diff <(grab_envget scripts/deploy) <(grab_envget scripts/preflight) | sed 's/^/      /' >&2
fi

# ── shell 脚本的静态检查 ────────────────────────────────────────────────────
# CI 里有同一条，这里再跑一遍是为了**在 push 之前**就发现——上一次是推上去了
# 才看到 CI 红。装了 shellcheck 就跑，没装就说一声跳过（开发机上不该为了跑测试装东西）。
# 两个部署脚本加起来两千行，而它们是 set -uo pipefail 不带 -e：
# 任何一处漏判返回值都会静默往下走，而 shellcheck 抓的正是这一类。
if command -v shellcheck >/dev/null 2>&1; then
  if sc_out=$(shellcheck -e SC1090,SC1091 scripts/* .githooks/commit-msg 2>&1); then
    ok "shellcheck 干净"
  else
    bad "shellcheck 有 $(printf '%s\n' "$sc_out" | grep -c '^In ') 处"
    printf '%s\n' "$sc_out" | grep '^In ' | head -5 | sed 's/^/      /' >&2
  fi
else
  printf '  \033[33m–\033[0m shellcheck 没装，跳过（CI 里会跑）\n'
fi

echo
if [ "$fails" -eq 0 ]; then
  echo "全部通过。"
else
  echo "$fails 条不通过。"
fi
exit "$fails"
