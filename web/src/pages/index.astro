---
import Base from '../layouts/Base.astro';
import EntryCard from '../components/EntryCard.astro';
import { publicEntries, TYPE_LABEL } from '../lib/entries';

const entries = await publicEntries();
const types = [...new Set(entries.map((e) => e.data.type))];



/**
 * 年份取 UTC，不取本地时区。
 *
 * frontmatter 里的 created 是纯日期（2026-09-04），z.coerce.date() 按 UTC 午夜解析。
 * 用 getFullYear() 的话，在 UTC 以西的机器上 `2026-01-01` 会被读成 2025——
 * 于是构建机器换个时区，首页就凭空多出一个年份标记，而卡片上的日期还写着 2026。
 * entries.ts 的 formatDate 因为同一个理由用 getUTC*，两处必须一致。
 */
const yearOf = (d: Date) => d.getUTCFullYear();
---

<Base description="一个人的可浏览版本。">
  {types.length > 1 && (
    <div class="filters" id="filters" role="group" aria-label="按类型筛选" hidden>
      <button data-type="all" aria-pressed="true">全部</button>
      {types.map((t) => <button data-type={t} aria-pressed="false">{TYPE_LABEL[t] ?? t}</button>)}
    </div>
  )}

  <ul class="stream" id="stream">
    {entries.map((e, i) => {
      // 年份标记：时间流上唯一的时间锚点。滚到第三屏时「我现在在哪一年」是靠猜的。
      // 它留在这里而不进 EntryCard，是因为它得知道**上一条**是哪一年——
      // 那是列表的事，不是单张卡的事。标签页也因此天然没有年份标记（它本来就短）。
      const year = yearOf(e.data.created);
      const newYear = i === 0 || yearOf(entries[i - 1].data.created) !== year;
      return (
        <Fragment>
          {newYear && (
            /* 它是 <li> 而不是 <div>：<ul> 的子元素只能是 <li>，塞个 div 进去
               HTML 就不合法了，而 .stream 是 grid，两者的视觉效果完全一样。

               但这样一来它就落进了筛选脚本的手里——见下面 <script> 里那段注释：
               筛选只认 li.card，年份标记走另一条路（跟着它下面还剩几张卡走）。

               aria-hidden：每张卡自己带一个完整日期的 <time>，年份是给眼睛扫读用的锚点，
               不是新信息。留在无障碍树里的话，读屏器会在列表中间念出一串裸年份，
               还会让「列表共 N 项」和筛选播报的条数对不上。 */
            <li class="yearmark" aria-hidden="true"><span>{year}</span></li>
          )}
          <EntryCard entry={e} />
        </Fragment>
      );
    })}
  </ul>

  <p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>

  {entries.length === 0 && (
    <p class="empty">
      还没有公开条目。往 <code>web/content/entries/</code> 里放一个 markdown,
      或者打通写入通道让 <code>server</code> 帮你放。
    </p>
  )}
</Base>

<script>
  // 纯客户端筛选：条目量到几千条之前都不值得为此引入框架。
  const filters = document.getElementById('filters');
  const stream = document.getElementById('stream');
  const status = document.getElementById('filter-status');

  // 按钮点了没反应比没有按钮更糟，所以 JS 到位之前不显示它们。
  filters?.removeAttribute('hidden');

  filters?.addEventListener('click', (ev) => {
    const btn = (ev.target as HTMLElement).closest('button');
    if (!btn || !stream) return;
    const want = btn.dataset.type;
    filters.querySelectorAll('button').forEach((b) =>
      b.setAttribute('aria-pressed', String(b === btn)),
    );

    // 卡片之间靠间距分开，不再靠分隔线，所以筛掉第一条也不会留下一条悬空的线——
    // 原先那套 data-lead 的补偿逻辑跟着分隔线一起去掉了。
    //
    // 只走 stream 的**直接子元素**，而且只把 .card 当卡片。两层限定各挡一件事：
    //   · 只看直接子元素——清单卡里铺的前几项也是 <li>。抓所有 li 的话，
    //     一按「清单」，被筛出来的清单卡自己的预览项会因为「dataset.type 不等于 list」
    //     被整排隐藏，卡片只剩一个孤零零的标题。
    //   · 只把 .card 当卡片——年份标记同样是顶层 <li>，但它没有 data-type。
    //     不区分的话它会被当成一张「类型不匹配」的卡，于是一按任何类型，
    //     整条流的年份锚点全部消失，而「全部」时它又被算进播报的条数里。
    const kids = [...stream.children] as HTMLElement[];
    for (const el of kids) {
      if (el.classList.contains('card')) {
        el.hidden = want !== 'all' && el.dataset.type !== want;
      }
    }

    // 年份标记不参与筛选，它跟着「自己下面还剩不剩卡片」走：
    // 一个底下一张卡都没有的「2024」是一句假话，比没有年份更糟。
    // 从头扫一遍，每遇到下一个标记就给上一个结账。
    let marker: HTMLElement | null = null;
    let kept = false;
    for (const el of kids) {
      if (el.classList.contains('yearmark')) {
        if (marker) marker.hidden = !kept;
        marker = el;
        kept = false;
      } else if (!el.hidden) {
        kept = true;
      }
    }
    if (marker) marker.hidden = !kept;

    if (status) {
      // 数的是卡片本身：清单卡的预览项从不被设 hidden，年份标记又不是内容。
      // 这个数字是屏幕阅读器用户按下筛选钮后唯一的反馈，多数一条都是错的。
      const n = stream.querySelectorAll(':scope > li.card:not([hidden])').length;
      status.textContent = `${btn.textContent}:${n} 条`;
    }
  });
</script>
